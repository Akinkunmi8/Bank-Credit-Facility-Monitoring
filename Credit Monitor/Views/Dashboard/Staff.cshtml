@model Credit_Monitor.ViewModel.StaffDashboardViewModel
@{
    ViewData["Title"] = "Credit Monitoring Dashboard";
}

<style>
    /* ===== Dashboard Look & Feel ===== */
    .stat-card {
        border-radius: 12px;
        border: 1px solid #e9ecef;
        background: #ffffff;
        transition: all .2s ease-in-out;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0,0,0,.06);
        }

    .stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }

    .accent-primary {
        border-left: 4px solid #0d6efd;
    }

    .accent-success {
        border-left: 4px solid #198754;
    }

    .accent-danger {
        border-left: 4px solid #dc3545;
    }

    .accent-warning {
        border-left: 4px solid #ffc107;
    }

    .table-card {
        border-radius: 14px;
    }

    .table-loader {
        display: none;
        align-items: center;
        justify-content: center;
        padding: 40px;
        gap: 10px;
    }
</style>

<div class="container-fluid mt-4">

    <!-- ===== Page Header ===== -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">Bank Credit Monitoring</h4>
            <small class="text-muted">Real-time overview of loan applications & turnaround status</small>
        </div>
    </div>

    <!-- ===== KPI CARDS ===== -->
    <div class="row g-3 mb-4">

        <div class="col-xl col-md-6">
            <div class="stat-card accent-primary p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted text-uppercase">Pending Loans</small>
                        <h3 class="fw-bold mb-0">@Model.TotalPendingLoans</h3>
                    </div>
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-6">
            <div class="stat-card accent-success p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted text-uppercase">Confirmed Loans</small>
                        <h3 class="fw-bold mb-0">@Model.TotalConfirmedLoans</h3>
                    </div>
                    <div class="stat-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-6">
            <div class="stat-card accent-danger p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted text-uppercase">Rejected Loans</small>
                        <h3 class="fw-bold mb-0">@Model.TotalRejectedLoans</h3>
                    </div>
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-6">
            <div class="stat-card accent-warning p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted text-uppercase">Within TAT</small>
                        <h3 class="fw-bold mb-0">@Model.WithinTAT</h3>
                    </div>
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-6">
            <div class="stat-card accent-danger p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted text-uppercase">Beyond TAT</small>
                        <h3 class="fw-bold mb-0">@Model.BeyondTAT</h3>
                    </div>
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ===== TABLE SECTION ===== -->
    <div class="card table-card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center g-2">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control border-0 bg-light"
                               placeholder="Search by Application No or Client Name">
                    </div>
                </div>

                <div class="col-md-6 text-end">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary">
                            <i class="bi bi-file-earmark-pdf"></i> PDF
                        </button>
                        <button class="btn btn-outline-secondary">
                            <i class="bi bi-file-earmark-spreadsheet"></i> CSV
                        </button>
                        <button onclick="loadTable('', 1)" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="tableContainer" class="position-relative">
            <div class="table-loader">
                <div class="spinner-border text-primary"></div>
                <strong class="text-primary">Updating records…</strong>
            </div>

            <partial name="_LoanTablePartial" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let timeout = null;

            $('#searchInput').on('keyup', function () {
                clearTimeout(timeout);
                let searchTerm = $(this).val();

                timeout = setTimeout(function () {
                    loadTable(searchTerm, 1);
                }, 500);
            });
        });

        function loadTable(search, page) {
            $(".table-loader").css("display", "flex");
            $("#tableContainer table").css("opacity", "0.3");

            $.ajax({
                url: '@Url.Action("FilterLoans", "Dashboard")',
                type: 'GET',
                data: { searchTerm: search, page: page },
                success: function (result) {
                    $('#tableContainer').html(result);
                },
                error: function () {
                    alert("Connection error. Please try again.");
                    $(".table-loader").hide();
                    $("#tableContainer table").css("opacity", "1");
                }
            });
        }
    </script>
}
