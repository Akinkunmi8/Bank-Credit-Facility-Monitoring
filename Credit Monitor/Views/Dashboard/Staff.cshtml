@model Credit_Monitor.ViewModel.StaffDashboardViewModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="container-fluid mt-3">
    <div class="row g-2 mb-4">
        <div class="col-md">
            <div class="card bg-primary text-white shadow-sm border-0 h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-bold mb-1" style="font-size: 0.75rem;">Pending Loan</h6>
                        <h2 class="mb-0 fw-bold">@Model.TotalPendingLoans</h2>
                    </div>
                    <i class="bi bi-hourglass-split fs-2 opacity-50"></i>
                </div>
                <a href="#" class="card-footer text-white text-decoration-none small d-flex justify-content-between border-top-0 py-2">
                    View Details <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md">
            <div class="card bg-success text-white shadow-sm border-0 h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-bold mb-1" style="font-size: 0.75rem;">Confirmed Loan</h6>
                        <h2 class="mb-0 fw-bold">@Model.TotalConfirmedLoans</h2>
                    </div>
                    <i class="bi bi-check-circle-fill fs-2 opacity-50"></i>
                </div>
                <a href="#" class="card-footer text-white text-decoration-none small d-flex justify-content-between border-top-0 py-2">
                    View Details <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md">
            <div class="card bg-danger text-white shadow-sm border-0 h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-bold mb-1" style="font-size: 0.75rem;">Rejected Loan</h6>
                        <h2 class="mb-0 fw-bold">@Model.TotalRejectedLoans</h2>
                    </div>
                    <i class="bi bi-shield-check fs-2 opacity-50"></i>
                </div>
                <a href="#" class="card-footer text-white text-decoration-none small d-flex justify-content-between border-top-0 py-2">
                    View Details <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md">
            <div class="card bg-warning text-dark shadow-sm border-0 h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-bold mb-1" style="font-size: 0.75rem;">Within TAT</h6>
                        <h2 class="mb-0 fw-bold">@Model.WithinTAT</h2>
                    </div>
                    <i class="bi bi-clock-history fs-2 opacity-50"></i>
                </div>
                <a href="#" class="card-footer text-dark text-decoration-none small d-flex justify-content-between border-top-0 py-2">
                    View Details <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md">
            <div class="card bg-danger text-white shadow-sm border-0 h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-bold mb-1" style="font-size: 0.75rem;">Beyond TAT</h6>
                        <h2 class="mb-0 fw-bold">@Model.BeyondTAT</h2>
                    </div>
                    <i class="bi bi-exclamation-diamond fs-2 opacity-50"></i>
                </div>
                <a href="#" class="card-footer text-white text-decoration-none small d-flex justify-content-between border-top-0 py-2">
                    View Details <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control border-start-0"
                               placeholder="Quick Search by Application No or Client Name...">
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-secondary btn-sm"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm"><i class="bi bi-file-earmark-spreadsheet"></i> CSV</button>
                        <button type="button" onclick="loadTable('', 1)" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="tableContainer">
            <div class="table-loader">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <strong class="ms-2 text-primary">Updating records...</strong>
            </div>

            <partial name="_LoanTablePartial" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let timeout = null;

            $('#searchInput').on('keyup', function () {
                clearTimeout(timeout);
                let searchTerm = $(this).val();

                timeout = setTimeout(function () {
                    loadTable(searchTerm, 1);
                }, 500);
            });
        });

                function loadTable(search, page) {
            // 1. Show the loader
            $(".table-loader").css("display", "flex");
            $("#tableContainer table").css("opacity", "0.3"); // Dim the old data

            $.ajax({
                url: '@Url.Action("FilterLoans", "Dashboard")',
                type: 'GET',
                data: { searchTerm: search, page: page },
                success: function (result) {
                    // 2. Replace HTML and hide loader
                    $('#tableContainer').html(result);
                },
                error: function () {
                    alert("Connection error. Please try again.");
                    $(".table-loader").hide();
                    $("#tableContainer table").css("opacity", "1");
                }
            });
        }
    </script>
}