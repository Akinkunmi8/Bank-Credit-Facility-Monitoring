@model Credit_Monitor.ViewModel.AODashboardViewModel

<div class="card shadow-sm border-0">

    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold text-info">
            <i class="bi bi-file-earmark-medical me-2"></i>Requested Loan Documents
        </h6>
        <span class="badge bg-info">
            @Model?.TotalItems ?? 0
        </span>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th class="ps-3">Application Ref</th>
                        <th>Document Name</th>
                        <th>Category</th>
                        <th class="text-center">Server Sync</th>
                        <th class="text-center">Verification</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model?.RequestedDocuments != null && Model.RequestedDocuments.Any())
                    {
                        foreach (var file in Model.RequestedDocuments)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-primary">
                                    @file.AppId.ToString().Substring(0, 8)...
                                </td>

                                <td class="fw-semibold text-dark">
                                    @file.FileName
                                </td>

                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">
                                        @file.DocType
                                    </span>
                                </td>

                                <td class="text-center">
                                    @if (file.IsFileExitOnServer)
                                    {
                                        <span class="badge bg-success-subtle text-success border">
                                            <i class="bi bi-cloud-check-fill me-1"></i> Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border">
                                            <i class="bi bi-cloud-slash-fill me-1"></i> Missing
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (file.IsVeriFied)
                                    {
                                        <i class="bi bi-patch-check-fill text-primary" style="font-size: 1.2rem;"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-dash-circle text-muted" style="opacity: 0.5;"></i>
                                    }
                                </td>

                                <td>
                                    <a asp-action="CustomerDetails" asp-controller="Dashboard" asp-route-id="@file.AppId"
                                       class="btn btn-sm btn-outline-primary py-0">
                                        View App
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="d-flex flex-column align-items-center">
                                    <i class="bi bi-file-earmark-x text-muted mb-2"
                                       style="font-size:3rem; opacity:.3;"></i>
                                    <h6 class="fw-light text-muted mb-1">
                                        No document requirements found
                                    </h6>
                                    <p class="small text-muted mb-2">
                                        Try adjusting your search for specific file names or types
                                    </p>
                                    <button class="btn btn-sm btn-outline-info"
                                            onclick="$('#searchInput').val(''); loadDocumentTable('', 1, 'TotalLoandocumentRequest');">
                                        Clear Search
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer bg-white border-top-0 py-2">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <small class="text-muted">
                    Total Requirements:
                    <strong>@Model?.TotalItems</strong>
                </small>
            </div>

            <div class="col-sm-6">
                <nav>
                    <ul class="pagination pagination-sm justify-content-end mb-0">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   href="javascript:void(0)"
                                   onclick="loadDocumentTable($('#searchInput').val(), @i, 'TotalLoandocumentRequest')">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>

</div>