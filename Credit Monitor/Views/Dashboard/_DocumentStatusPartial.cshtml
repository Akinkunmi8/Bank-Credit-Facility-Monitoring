@model IEnumerable<Credit_Monitor.ViewModel.DocumentDetailsViewModel>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h6 class="mb-0 text-primary fw-bold">
            <i class="bi bi-file-earmark-check me-2"></i>Customer Documents
        </h6>
        <span class="badge bg-primary">@Model?.Count() Files</span>
    </div>

    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light small text-uppercase">
                        <tr>
                            <th class="ps-3">File Name</th>
                            <th>Category</th>
                            <th class="text-center">Verified</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center">
                                        <i class="bi @doc.DisplayIcon fs-4 me-3"></i>
                                        <div>
                                            <div class="fw-bold text-dark">@doc.FileName</div>
                                            @* <small class="text-muted text-uppercase">@doc.Extension</small> *@
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-light text-dark border">@doc.DocType</span>
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input cursor-pointer" type="checkbox"
                                               @(doc.IsVerified ? "checked" : "")
                                               onchange="toggleVerification('@doc.FileId', this.checked)">
                                    </div>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-secondary"
                                                onclick="openEditModal('@doc.FileId', '@doc.FileName', '@doc.DocType', '@doc.ContentType', '@doc.IsVerified')">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </button>

                                        <button class="btn btn-sm btn-outline-danger"
                                                onclick="deleteDocument('@doc.BatchId', '@doc.FileId')">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-cloud-upload fs-1 text-light-emphasis"></i>
                <p class="mt-2 text-muted">No documents found for this record.</p>
            </div>
        }
    </div>

    <div class="card-footer bg-light border-0 py-3">
        <button class="btn btn-primary w-100" onclick="openAddModal()">
            <i class="bi bi-plus-circle me-2"></i>Add New Document
        </button>
    </div>
</div>

<div class="modal fade" id="editFileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Document Properties</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editFileId" />
                <input type="hidden" id="editFileIsVerified" />
                <div class="mb-3">
                    <label class="form-label fw-bold">File Name</label>
                    <input type="text" id="editFileName" class="form-control" placeholder="Enter file name" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Document Category</label>
                    <select id="editDocType" class="form-select" onchange="toggleEditOtherInput()">
                        <option value="CAT">CAT (Credit Assessment)</option>
                        <option value="CACOM">CACOM</option>
                        <option value="Identity">Identification</option>
                        <option value="Tax">Tax Script</option>
                        <option value="Other">Other Document</option>
                    </select>
                </div>

                <div class="mb-3 d-none" id="editOtherTypeContainer">
                    <label class="form-label fw-bold text-primary">Please Specify Document Type</label>
                    <input type="text" id="editCustomDocType" class="form-control" placeholder="e.g. Utility Bill" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Document Format</label>
                    <select id="editDocFormat" class="form-select">
                        <option value="application/pdf">PDF Document</option>
                        <option value="application/vnd.openxmlformats-officedocument.wordprocessingml.document">Word Doc</option>
                        <option value="image/jpeg">JPEG Image</option>
                        <option value="application/vnd.ms-excel">Excel Sheet</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitFileEdit()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addFileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>New Document Property</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">File Name</label>
                    <input type="text" id="addFileName" class="form-control" placeholder="e.g. Tax_Statement_2025" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Document Type</label>
                    <select id="addDocType" class="form-select" onchange="toggleOtherInput()">
                        <option value="CAT">CAT (Credit Assessment)</option>
                        <option value="CACOM">CACOM</option>
                        <option value="Identity">Identification</option>
                        <option value="Tax">Tax Script</option>
                        <option value="Other">Other Document</option>
                    </select>
                </div>
                <div class="mb-3 d-none" id="otherTypeContainer">
                    <label class="form-label fw-bold text-primary">Please Specify Document Type</label>
                    <input type="text" id="customDocType" class="form-control" placeholder="e.g. Utility Bill, Reference Letter" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Document Format</label>
                    <select id="addContentType" class="form-select">
                        <option value="application/pdf">PDF Document</option>
                        <option value="application/vnd.openxmlformats-officedocument.wordprocessingml.document">Word Doc</option>
                        <option value="image/jpeg">JPEG Image</option>
                        <option value="application/vnd.ms-excel">Excel Sheet</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" onclick="submitNewFile()">
                    <i class="bi bi-save me-1"></i> Save Property
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-0">Are you sure you want to delete this document? This action is permanent.</p>
                <input type="hidden" id="deleteFileId" />
                <input type="hidden" id="deleteAppId" />
            </div>
            <div class="modal-footer bg-light d-flex justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger px-4" onclick="executeDelete()">
                    Delete Now
                </button>
            </div>
        </div>
    </div>
</div>
<script>
    // 1. Toggle Verification
    function toggleVerification(fileId, isChecked) {
        fetch(`/Dashboard/UpdateVerification?fileId=${fileId}&status=${isChecked}`, {
            method: 'POST'
        }).then(response => {
            if (response.ok) {
            showNotification("Verification status updated!");
            } else {
                showNotification("Failed to update verification.", "error");
            }
        });
    }

        function openEditModal(id, name, type, format, isVerified) {
        document.getElementById('editFileId').value = id;
        document.getElementById('editFileName').value = name;
        document.getElementById('editDocFormat').value = format;
        document.getElementById('editFileIsVerified').value = isVerified;

        const standardTypes = ['CAT', 'CACOM', 'Identity', 'Tax'];
        const select = document.getElementById('editDocType');
        const customInput = document.getElementById('editCustomDocType');
        const container = document.getElementById('editOtherTypeContainer');

        if (standardTypes.includes(type)) {
            select.value = type;
            container.classList.add('d-none');
        } else {
            select.value = 'Other';
            customInput.value = type;
            container.classList.remove('d-none');
        }

        var myModal = new bootstrap.Modal(document.getElementById('editFileModal'));
        myModal.show();
    }

        function submitFileEdit() {
        let finalDocType = $('#editDocType').val();

        if (finalDocType === 'Other') {
            finalDocType = $('#editCustomDocType').val();
            if (!finalDocType || finalDocType.trim() === "") {
                alert("Please specify the custom document type.");
                return;
            }
        }

        const payload = {
            id: $('#editFileId').val(),
            appId: '@ViewBag.CurrentAppId' || window.location.pathname.split('/').pop(),
            fileName: $('#editFileName').val(),
            docType: finalDocType,
            contentType: $('#editDocFormat').val(),
            isVeriFied: $('#editFileIsVerified').val() === "True" || $('#editFileIsVerified').val() === "true"
        };

        $.ajax({
            url: '/Dashboard/EditFileProperties',
            type: 'POST',
            data: payload,
            success: function (htmlResult) {
                $('#editFileModal').modal('hide');
                $('#docStatusContainer').html(htmlResult);
                showNotification("Document updated successfully.");
            },
            error: function (xhr) {
                showNotification("Error updating document.", "error");
            }
        });
    }

        // Function to show the modal
    function openAddModal() {
        // Clear previous values
        $('#addFileName').val('');
        $('#addDocType').val('CAT');

        // Show modal
        var myModal = new bootstrap.Modal(document.getElementById('addFileModal'));
        myModal.show();
    }


    function submitNewFile() {
        // Attempt to get AppId from the URL as a fallback
        let appId = '@Model?.FirstOrDefault()?.BatchId';
        if (!appId || appId.includes('00000000')) {
            appId = window.location.pathname.split('/').pop();
        }

        let finalDocType = $('#addDocType').val();

        // If 'Other' is selected, use the value from the custom text box instead
        if (finalDocType === 'Other') {
            finalDocType = $('#customDocType').val();

            if (!finalDocType || finalDocType.trim() === "") {
                alert("Please specify the document type.");
                return;
            }
        }

        // Create a simple object (NOT stringified)
        const payload = {
            appId: appId,
            fileName: $('#addFileName').val(),
            docType: finalDocType,
            contentType: $('#addContentType').val()
        };

        if (!payload.fileName) {
            alert("Please provide a file name.");
            return;
        }

        $.ajax({
            url: '/Dashboard/AddFileProperties',
            type: 'POST',
            data: payload, 
            success: function (response) {
                $('#addFileModal').modal('hide');
                $('#docStatus').data('loaded', false);
                loadDocuments(appId);
                showNotification("New document property added!");
            },
            error: function (xhr) {
                showNotification("Could not add document property.", "error");
            }
        });
    }

    function toggleOtherInput() {
        const select = document.getElementById('addDocType');
        const container = document.getElementById('otherTypeContainer');

        if (select.value === 'Other') {
            container.classList.remove('d-none');
            document.getElementById('customDocType').focus();
        } else {
            container.classList.add('d-none');
        }
    }

    function toggleEditOtherInput() {
        const select = document.getElementById('editDocType');
        const container = document.getElementById('editOtherTypeContainer');

        if (select.value === 'Other') {
            container.classList.remove('d-none');
        } else {
            container.classList.add('d-none');
            document.getElementById('editCustomDocType').value = ''; // Clear it
        }
    }

    function showNotification(message, type = 'success') {
        const toastElement = document.getElementById('liveToast');
        const toastMessage = document.getElementById('toastMessage');
        const toastIcon = document.getElementById('toastIcon');

        // Set colors and icons
        toastElement.classList.remove('bg-success', 'bg-danger', 'bg-warning');
        if (type === 'success') {
            toastElement.classList.add('bg-success');
            toastIcon.className = 'bi bi-check-circle-fill me-2';
        } else {
            toastElement.classList.add('bg-danger');
            toastIcon.className = 'bi bi-exclamation-triangle-fill me-2';
        }

        toastMessage.textContent = message;
        const toast = new bootstrap.Toast(toastElement, { delay: 3000 });
        toast.show();
    }

         // Step 1: Open the modal and store the IDs
    function deleteDocument(appId, fileId) {
        // Set the hidden inputs in the delete modal
        $('#deleteAppId').val(appId);
        $('#deleteFileId').val(fileId);

        // Show the modal
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
        deleteModal.show();
    }

    // Step 2: Actually run the AJAX call
    function executeDelete() {
        const appId = $('#deleteAppId').val();
        const fileId = $('#deleteFileId').val();
        const btn = $('#confirmDeleteBtn');

        // UI Feedback
        const originalText = btn.html();
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

        $.ajax({
            url: '/Dashboard/DeleteFile',
            type: 'POST',
            data: { appId: appId, fileId: fileId },
            success: function (htmlResult) {
                // Hide modal and refresh table
                bootstrap.Modal.getInstance(document.getElementById('deleteConfirmModal')).hide();
                $('#docStatusContainer').html(htmlResult);
                showNotification("Document removed successfully.");
            },
            error: function (xhr) {
                btn.prop('disabled', false).html(originalText);
                showNotification("Error: Could not delete document.", "error");
            }
        });
    }
</script>