@model IEnumerable<Credit_Monitor.ViewModel.DocumentDetailsViewModel>

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
    <h6 class="text-primary fw-bold mb-0">
        <i class="bi bi-folder-check me-2"></i>BATCH FILES
    </h6>
    <span class="badge bg-info">Total Files: @Model.Count()</span>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover border align-middle">
        <thead class="table-light">
            <tr>
                <th>File Name</th>
                <th>Category</th>
                <th>Format</th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doc in Model)
            {
                <tr>
                    <td>
                        <i class="bi @doc.DisplayIcon me-2"></i>
                        <span class="fw-semibold text-dark">@doc.FileName</span>
                    </td>
                    <td><span class="badge bg-secondary-subtle text-secondary border">@doc.DocType</span></td>
                    <td class="text-uppercase small">@doc.Extension</td>
                    <td class="text-center">
                        <a href="@Url.Action("ViewDocument", "Dashboard", new { batchId = doc.BatchId, category = doc.DocType, ext = doc.Extension })"
                           target="_blank"
                           class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye"></i> View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>