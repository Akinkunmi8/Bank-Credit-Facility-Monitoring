@model IEnumerable<Credit_Monitor.ViewModel.DocumentDetailsViewModel>

<div class="card shadow-sm border-0">
    <!-- Header -->
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0 text-primary fw-bold">
            <i class="bi bi-folder2-open me-2"></i>Batch Documents
        </h6>
        <span class="badge bg-primary-subtle text-primary border">
            @Model?.Count() ?? 0 Files
        </span>
    </div>

    <!-- Body -->
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-secondary small text-uppercase">
                        <tr>
                            <th>File</th>
                            <th>Category</th>
                            <th>Format</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <!-- File Name -->
                                <td>
                                    <i class="bi @doc.DisplayIcon text-primary me-2 fs-5"></i>
                                    <span class="fw-semibold">@doc.FileName</span>
                                </td>

                                <!-- Category -->
                                <td>
                                    <span class="badge bg-info-subtle text-info border">
                                        @doc.DocType
                                    </span>
                                </td>

                                <!-- File Extension -->
                                <td>
                                    <span class="badge bg-dark-subtle text-dark text-uppercase">
                                        @doc.Extension
                                    </span>
                                </td>

                                <!-- Action -->
                                <td class="text-center">
                                    <a asp-controller="Dashboard"
                                       asp-action="ViewDocument"
                                       asp-route-batchId="@doc.BatchId"
                                       asp-route-category="@doc.DocType"
                                       asp-route-ext="@doc.Extension"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary px-3">
                                        <i class="bi bi-eye me-1"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="text-center py-5">
                <i class="bi bi-folder-x fs-1 text-muted"></i>
                <p class="mt-3 text-muted fw-semibold">
                    No documents uploaded for this batch.
                </p>
            </div>
        }
    </div>
</div>
