@model Credit_Monitor.ViewModel.AODashboardViewModel
@using System.Security.Claims;
@{
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Guest";
    ViewData["Title"] = "AO Performance Dashboard";
}

<style>
    :root {
        --cm-primary: #0d6efd;
        --cm-primary-soft: #eef5ff;
        --cm-success: #198754;
        --cm-success-soft: #edf8f2;
        --cm-warning: #e6a700;
        --cm-warning-soft: #fff8e5;
        --cm-danger: #dc3545;
        --cm-danger-soft: #fff0f2;
        --cm-info: #0891b2;
        --cm-info-soft: #ecfbff;
        --cm-text: #172033;
        --cm-muted: #697386;
        --cm-border: #e7ebf1;
        --cm-surface: #ffffff;
        --cm-page: #f7f9fc;
    }

    .ao-workspace {
        padding: 8px 8px 30px;
    }

    /* HEADER */

    .workspace-header {
        background: linear-gradient(135deg, #ffffff 0%, #f7faff 100%);
        border: 1px solid var(--cm-border);
        border-radius: 18px;
        padding: 24px 26px;
        margin-bottom: 22px;
        box-shadow: 0 5px 20px rgba(23, 32, 51, .04);
    }

    .workspace-eyebrow {
        color: var(--cm-primary);
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .09em;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .workspace-title {
        color: var(--cm-text);
        font-weight: 750;
        margin: 0;
        font-size: 1.65rem;
    }

    .workspace-subtitle {
        color: var(--cm-muted);
        margin: 7px 0 0;
        font-size: .94rem;
    }

    .workspace-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        background: var(--cm-success-soft);
        color: var(--cm-success);
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
    }

    .workspace-status-dot {
        width: 7px;
        height: 7px;
        background: var(--cm-success);
        border-radius: 50%;
    }

    /* KPI */

    #kpiNav {
        margin-bottom: 22px !important;
    }

    #kpiNav .nav-link {
        width: 100%;
        padding: 0;
        border: 0;
        background: transparent !important;
        text-align: left;
    }

    .metric-card {
        position: relative;
        min-height: 150px;
        padding: 20px;
        background: var(--cm-surface);
        border: 1px solid var(--cm-border);
        border-radius: 16px;
        overflow: hidden;
        transition: transform .18s ease,
                    box-shadow .18s ease,
                    border-color .18s ease;
    }

    .metric-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(23, 32, 51, .08);
    }

    #kpiNav .nav-link.active .metric-card {
        border-color: var(--cm-primary);
        box-shadow: 0 8px 26px rgba(13, 110, 253, .12);
    }

    #kpiNav .nav-link.active .metric-card::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 4px;
        background: var(--cm-primary);
    }

    .metric-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .metric-label {
        color: var(--cm-muted);
        font-size: .73rem;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .metric-value {
        margin-top: 10px;
        color: var(--cm-text);
        font-size: 2rem;
        line-height: 1;
        font-weight: 800;
    }

    .metric-description {
        color: var(--cm-muted);
        font-size: .78rem;
        margin-top: 15px;
    }

    .metric-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 1.2rem;
    }

    .metric-icon.danger {
        color: var(--cm-danger);
        background: var(--cm-danger-soft);
    }

    .metric-icon.warning {
        color: #c58b00;
        background: var(--cm-warning-soft);
    }

    .metric-icon.success {
        color: var(--cm-success);
        background: var(--cm-success-soft);
    }

    .metric-icon.info {
        color: var(--cm-info);
        background: var(--cm-info-soft);
    }

    /* TABLE WORKSPACE */

    .operations-card {
        border: 1px solid var(--cm-border) !important;
        border-radius: 18px !important;
        overflow: hidden;
        box-shadow: 0 5px 24px rgba(23, 32, 51, .045) !important;
    }

    .operations-toolbar {
        padding: 17px 20px;
        background: #fff;
        border-bottom: 1px solid var(--cm-border);
    }

    .search-box {
        position: relative;
        max-width: 620px;
    }

    .search-box i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #87909f;
        z-index: 2;
    }

    .search-box input {
        height: 46px;
        padding-left: 45px;
        background: #f7f9fc;
        border: 1px solid transparent;
        border-radius: 11px;
    }

    .search-box input:focus {
        background: #fff;
        border-color: #b8d4ff;
        box-shadow: 0 0 0 3px rgba(13,110,253,.08);
    }

    .toolbar-btn {
        height: 40px;
        border-radius: 9px !important;
        font-weight: 600;
    }

    .table-loader {
        display: none;
        min-height: 160px;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: rgba(255,255,255,.88);
    }

    @@media (max-width: 768px) {
        .workspace-header {
            padding: 19px;
        }

        .workspace-title {
            font-size: 1.35rem;
        }

        .metric-card {
            min-height: 135px;
        }
    }
</style>

<div class="container-fluid mt-4 ao-workspace">

    <div class="workspace-header">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div>
                <div class="workspace-eyebrow">
                    Credit Operations
                </div>

                <h2 class="workspace-title">
                    Account Officer Workspace
                </h2>

                <p class="workspace-subtitle">
                    Monitor assigned facilities, outstanding document requests
                    and resolution turnaround.
                </p>
            </div>

            <div class="workspace-status">
                <span class="workspace-status-dot"></span>
                Operational
            </div>

        </div>
    </div>

    <ul class="nav row g-3 border-0" id="kpiNav">

    <li class="nav-item col-xl-3 col-md-6">
        <button class="nav-link active"
                data-bs-toggle="pill"
                onclick="loadTable('', 1, 'Unresolved')">

            <div class="metric-card">

                <div class="metric-top">
                    <div>
                        <div class="metric-label">
                            Returned for Resolution
                        </div>
                        <div class="metric-value">
                            @Model.TotalUnresolvedLoans
                        </div>
                    </div>

                    <div class="metric-icon danger">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>

               <div class="metric-description">
                    Cases returned by CMO requiring corrective response
                </div>

            </div>
        </button>
    </li>


    <li class="nav-item col-xl col-md-6">
        <button class="nav-link"
                data-bs-toggle="pill"
                onclick="loadTable('', 1, 'WithinTATUnresolved')">

            <div class="metric-card">

                <div class="metric-top">
                    <div>
                        <div class="metric-label">Within TAT</div>

                        <div class="metric-value">
                            @Model.WithinTATUnresolved
                        </div>
                    </div>

                    <div class="metric-icon success">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>

                <div class="metric-description">
                    Cases progressing within SLA
                </div>

            </div>
        </button>
    </li>


    <li class="nav-item col-xl-3 col-md-6">
        <button class="nav-link"
                data-bs-toggle="pill"
                onclick="loadTable('', 1, 'BeyondTATUnresolved')">

            <div class="metric-card">

                <div class="metric-top">
                    <div>
                        <div class="metric-label">Beyond TAT</div>

                        <div class="metric-value">
                            @Model.BeyondTATUnresolved
                        </div>
                    </div>

                    <div class="metric-icon danger">
                        <i class="bi bi-alarm"></i>
                    </div>
                </div>

                <div class="metric-description">
                    Cases requiring immediate attention
                </div>

            </div>
        </button>
    </li>


    <li class="nav-item col-xl-3 col-md-6">
        <button class="nav-link"
                data-bs-toggle="pill"
                onclick="loadDocumentTable('', 1, 'TotalLoandocumentRequest')">

            <div class="metric-card">

                <div class="metric-top">
                    <div>
                        <div class="metric-label">
                            Outstanding Documents
                        </div>

                        <div class="metric-value">
                            @Model.TotalLoanDocumentRequest
                        </div>
                    </div>

                    <div class="metric-icon info">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                </div>

                <div class="metric-description">
                    Requested documents pending completion
                </div>

            </div>
        </button>
    </li>

</ul>

    <div class="card operations-card">

    <div class="operations-toolbar">

        <div class="row align-items-center g-3">

            <div class="col-lg-7">

                <div class="search-box">
                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search by application, customer or account..." />
                </div>

            </div>

            <div class="col-lg-5">

                <div class="d-flex justify-content-lg-end gap-2">

                    <button id="btnDownloadPdf"
                            class="btn btn-outline-secondary toolbar-btn px-3">
                        <i class="bi bi-file-earmark-pdf me-1"></i>
                        PDF
                    </button>

                    <button id="btnDownloadCsv"
                            class="btn btn-outline-secondary toolbar-btn px-3">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i>
                        CSV
                    </button>

                    <button onclick="refreshCurrentTable()"
                            class="btn btn-outline-primary toolbar-btn px-3">
                        <i class="bi bi-arrow-clockwise me-1"></i>
                        Refresh
                    </button>

                </div>

            </div>

        </div>

    </div>

    <div id="tableContainer" class="position-relative">

        <div class="table-loader">
            <div class="spinner-border spinner-border-sm text-primary"></div>
            <span class="fw-semibold text-primary">
                Loading records...
            </span>
        </div>

        <partial name="_UnresolvedLoanTablePartial" model="Model" />

    </div>

</div>

<div id="downloadOverlay" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none align-items-center justify-content-center" style="z-index: 1000;">
    <div class="text-center">
        <div class="spinner-grow text-primary" role="status"></div>
        <p class="mt-2 fw-bold text-primary">Processing document...</p>
    </div>
</div>
@section Scripts {
    <script>
        let currentStatus = 'Unresolved';

        $(document).ready(function () {
            let timeout = null;

            $('#searchInput').on('keyup', function () {
                clearTimeout(timeout);
                let searchTerm = $(this).val();
                timeout = setTimeout(function () {
                    loadTable(searchTerm, 1, currentStatus);
                }, 500);
            });

            $('#btnDownloadPdf, #btnDownloadCsv').click(function () {
                const format = $(this).attr('id').includes('Pdf') ? 'pdf' : 'csv';
                downloadFile(format, $('#searchInput').val(), "ao", currentStatus);
            });
        });

        function refreshCurrentTable() {
            loadTable($('#searchInput').val(), 1, currentStatus);
        }

        function loadTable(search, page, status) {
            currentStatus = status;
            const loader = $(".table-loader");

            loader.addClass('d-flex').show();
            $("#tableContainer table").css("opacity", "0.3");

            $.ajax({
                url: '@Url.Action("FilterLoans", "Dashboard")',
                type: 'GET',
                data: { searchTerm: search, page: page, status: status, role: "ao" },
                success: function (result) {
                    $('#tableContainer').html(result);
                    loader.removeClass('d-flex').hide();
                },
                error: function () {
                    alert("Failed to load your records.");
                    loader.removeClass('d-flex').hide();
                    $("#tableContainer table").css("opacity", "1");
                }
            });
        }

        function loadDocumentTable(search, page, status) {
            currentStatus = status; // Track that we are now in 'Document' mode
            const loader = $(".table-loader");

            loader.addClass('d-flex').show();
            $("#tableContainer").css("opacity", "0.3");

            $.ajax({
                url: '@Url.Action("FilterDocumentRequests", "Dashboard")', // New Endpoint
                type: 'GET',
                data: { searchTerm: search, page: page, status: status },
                success: function (result) {
                    $('#tableContainer').html(result);
                    loader.removeClass('d-flex').hide();
                    $("#tableContainer").css("opacity", "1");
                },
                error: function () {
                    alert("Failed to load document requirements.");
                    loader.removeClass('d-flex').hide();
                    $("#tableContainer").css("opacity", "1");
                }
            });
        }

        function downloadFile(format, search, role, status) {
            const $overlay = $('#downloadOverlay');
            $overlay.removeClass('d-none').addClass('d-flex');

            $.ajax({
                url: '@Url.Action("ExportLoans", "Dashboard")',
                type: 'GET',
                data: { format: format, searchTerm: search, role: role, status: status },
                xhrFields: { responseType: 'blob' },
                success: function (data, s, xhr) {
                    const blob = new Blob([data], { type: xhr.getResponseHeader('Content-Type') });
                    const link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    link.download = `AO_Report_${status}_${new Date().getTime()}.${format}`;
                    link.click();
                    $overlay.removeClass('d-flex').addClass('d-none');
                },
                error: function () {
                    alert("Export failed.");
                    $overlay.removeClass('d-flex').addClass('d-none');
                }
            });
        }
    </script>
}