@model Credit_Monitor.ViewModel.AODashboardViewModel

<div class="card shadow-sm border-0">

    <!-- ===== Card Header ===== -->
    <div class="card-header bg-light d-flex justify-content-between align-items-center">

        <h6 class="mb-0 fw-bold text-primary">
            <i class="bi bi-arrow-return-left me-2"></i>
            Returned for Resolution
        </h6>

        <span class="badge bg-primary">
            @(Model?.TotalItems ?? 0)
        </span>

    </div>

    <!-- ===== Table ===== -->
    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light small text-uppercase">
                    <tr>
                        <th class="ps-3">Application No.</th>
                        <th>Client Name</th>
                        <th>Product</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Since</th>
                        <th>Branch</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model?.loans != null && Model.loans.Any())
                    {
                        foreach (var loan in Model.loans)
                        {
                            <tr>

                                <!-- Application Number -->
                                <td class="ps-3 fw-semibold">

                                    <a asp-controller="Loan"
                                       asp-action="ResolutionCenter"
                                       asp-route-id="@loan.accounT_NUMBER"
                                       class="text-decoration-none text-primary">

                                        @loan.id

                                    </a>

                                </td>

                                <!-- Customer -->
                                <td class="fw-semibold text-dark">
                                    @loan.accounT_NAME
                                </td>

                                <!-- Product -->
                                <td>

                                    <span class="badge bg-secondary-subtle
                                                 text-secondary border">
                                        @loan.facilitY_TYPE
                                    </span>

                                </td>

                                <!-- Location -->
                                <td class="text-muted">
                                    @loan.regioN_NAME
                                </td>

                                <!-- Workflow Status -->
                                <td>

                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-arrow-return-left me-1"></i>
                                        Action Required
                                    </span>

                                    @if (loan.dayS_PAST_DUE > 0)
                                    {
                                        <div class="small text-danger mt-1">
                                            Past Due · @loan.dayS_PAST_DUE days
                                        </div>
                                    }

                                </td>

                                <!-- Since -->
                                <td class="text-muted small">
                                    One week ago
                                </td>

                                <!-- Branch -->
                                <td class="text-muted">
                                    @loan.brancH_NAME
                                </td>

                                <!-- Actions -->
                                <td class="text-end pe-3">

                                    <div class="d-flex justify-content-end gap-2">

                                        <!-- Secondary: Customer Details -->
                                        <a asp-controller="Dashboard"
                                           asp-action="CustomerDetails"
                                           asp-route-id="@loan.id"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="View customer details">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <!-- Primary: Respond to CMO -->
                                        <a asp-controller="Loan"
                                           asp-action="ResolutionCenter"
                                           asp-route-id="@loan.accounT_NUMBER"
                                           class="btn btn-sm btn-primary">

                                            <i class="bi bi-reply-fill me-1"></i>
                                            Respond

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center py-5">

                                <div class="d-flex flex-column align-items-center">

                                    <i class="bi bi-check-circle text-success mb-2"
                                       style="font-size:3rem; opacity:.4;">
                                    </i>

                                    <h6 class="fw-semibold text-muted mb-1">
                                        No applications awaiting resolution
                                    </h6>

                                    <p class="small text-muted mb-2">
                                        There are currently no cases returned
                                        by CMO requiring corrective action.
                                    </p>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            onclick="$('#searchInput').val('');
                                                     loadTable('', 1, currentStatus);">

                                        <i class="bi bi-arrow-clockwise me-1"></i>
                                        Refresh

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- ===== Pagination ===== -->
    <div class="card-footer bg-white border-top-0 py-2">

        <div class="row align-items-center">

            <div class="col-sm-6">

                <small class="text-muted">
                    Total Records:
                    <strong>@(Model?.TotalItems ?? 0)</strong>
                </small>

            </div>

            <div class="col-sm-6">

                <nav>

                    <ul class="pagination pagination-sm
                               justify-content-end mb-0">

                        @if (Model != null)
                        {
                            for (int pageNumber = 1;
                                 pageNumber <= Model.TotalPages;
                                 pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">

                                    <a class="page-link"
                                       href="javascript:void(0)"
                                       onclick="loadTable($('#searchInput').val(), @pageNumber, currentStatus)">
                                        @pageNumber
                                    </a>

                                </li>
                            }
                        }

                    </ul>

                </nav>

            </div>

        </div>

    </div>

</div>