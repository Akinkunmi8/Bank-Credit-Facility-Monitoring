@model Credit_Monitor.ViewModel.StaffDashboardViewModel

<style>
    /* ===== Enterprise Table Styling ===== */
    .credit-table th {
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #6c757d;
        white-space: nowrap;
    }

    .credit-table td {
        font-size: .875rem;
        vertical-align: middle;
        white-space: nowrap;
    }

    .credit-table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .badge-risk {
        font-weight: 500;
        padding: .35em .6em;
        border-radius: 6px;
    }

    .badge-current {
        background-color: rgba(25, 135, 84, .1);
        color: #198754;
    }

    .badge-pastdue {
        background-color: rgba(220, 53, 69, .1);
        color: #dc3545;
    }

    .empty-state i {
        opacity: .25;
    }

    .pagination .page-link {
        border-radius: 6px;
        margin-left: 4px;
    }
</style>

<div class="table-responsive">
    <table class="table credit-table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th class="ps-3">Application No</th>
                <th>Client Name</th>
                <th>Product</th>
                <th>Location</th>
                <th>Status</th>
                <th>Since</th>
                <th>Branch</th>
            </tr>
        </thead>

        <tbody>
            @if (Model?.loans != null && Model.loans.Any())
            {
                foreach (var loan in Model.loans)
                {
                    <tr>
                        <td class="ps-3">
                            <a asp-action="CustomerDetails"
                               asp-route-id="@loan.id"
                               class="fw-semibold text-primary text-decoration-none">
                                @loan.id
                            </a>
                        </td>

                        <td class="fw-medium">@loan.accounT_NAME</td>

                        <td>
                            <span class="text-muted">@loan.facilitY_TYPE</span>
                        </td>

                        <td>@loan.regioN_NAME</td>

                        <td>
                            @if (loan.dayS_PAST_DUE > 0)
                            {
                                <span class="badge badge-risk badge-pastdue">
                                    Past Due · @loan.dayS_PAST_DUE d
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-risk badge-current">
                                    Current
                                </span>
                            }
                        </td>

                        <td class="text-muted">One week ago</td>

                        <td>@loan.brancH_NAME</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="py-5">
                        <div class="d-flex flex-column align-items-center empty-state">
                            <i class="bi bi-search mb-3" style="font-size: 3rem;"></i>
                            <h6 class="fw-semibold text-muted">No records found</h6>
                            <p class="small text-muted text-center mb-3">
                                Try adjusting your search or clear the filter to view all loan applications.
                            </p>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    onclick="$('#searchInput').val(''); loadTable('', 1);">
                                Clear Search
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ===== Footer / Pagination ===== -->
<div class="card-footer bg-white border-top-0 py-2">
    <div class="row align-items-center">
        <div class="col-sm-6">
            <small class="text-muted">
                Total Records: <strong>@Model.TotalItems</strong>
            </small>
        </div>

        <div class="col-sm-6">
            <nav>
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="javascript:void(0)"
                               onclick="loadTable($('#searchInput').val(), @i)">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>
