@model Credit_Monitor.ViewModel.PendingLoanWithCustomerDetailsViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Customer Details";
    var loan = Model.loan;
    var customer = Model.customer;
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Guest";
}

<div class="sticky-top bg-white shadow-sm border-bottom pb-2 mb-3 pt-3" style="top: 0; z-index: 1020;">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-md-4">
                <h6 class="mb-0 fw-bold">Application Id : <span class="text-primary">@loan?.id</span></h6>
            </div>
            <div class="col-md-4 text-center">
                <h6 class="mb-0 fw-bold">Applicant Name : <span class="text-primary">@loan?.accounT_NAME</span></h6>
            </div>
        </div>

        <div class="row align-items-center">
            <div class="col-md-6">
                <h5 class="text-primary fw-bold mb-0">Post Disbursement Stage</h5>
            </div>
            <div class="col-md-6 text-end">
                <div class="d-flex justify-content-end gap-2">
                    @if (userRole == "supervisor")
                    {
                        <a asp-action="ApproveLoan" asp-controller="Loan" asp-route-AccNum="@loan?.accounT_NUMBER" class="btn btn-success btn-sm px-3 fw-bold">
                            <i class="bi bi-check-circle-fill me-1"></i> Approve Loan Details
                        </a>
                    }
                    else
                    {
                        <a asp-action="ValidateCAT" asp-controller="Loan" asp-route-AccNum="@loan?.accounT_NUMBER" class="btn btn-warning btn-sm px-3 fw-bold">
                            <i class="bi bi-shield-check me-1"></i> Validate with CAT
                        </a>
                    }
                    <button onclick="history.back()" class="btn btn-secondary btn-sm px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <ul class="nav nav-tabs bg-light border-0 mb-3" id="detailsTab" role="tablist">
        <li class="nav-item">
            <button class="nav-link active fw-bold small text-uppercase" data-bs-toggle="tab" data-bs-target="#basicInfo">Basic Info</button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold small text-uppercase"
                    id="doc-status-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#docStatus"
                    type="button"
                    onclick="loadDocuments('@Model.loan?.LoanFileBatchId')">
                Document Status
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold small text-uppercase"
                    id="covenant-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#covenantStatus"
                    type="button"
                    onclick="loadCovenants('@Model.loan?.id')">
                Covenant Tracker
            </button>
        </li>
    </ul>

    <div class="tab-content border rounded p-4 bg-white shadow-sm">
        <div class="tab-pane fade show active" id="basicInfo">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                <h6 class="text-primary fw-bold mb-0">
                    <i class="bi bi-person-lines-fill me-2"></i>Full Customer Profile
                </h6>
                <span class="badge bg-info text-dark">Record Status: Active</span>
            </div>

            <p class="fw-bold text-dark border-start border-primary border-4 ps-2 mb-3">Identity & Personal Details</p>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="small fw-bold text-muted">Title</label>
                    <input type="text" class="form-control form-control-sm bg-light" value="@customer?.tittle" readonly>
                </div>
                <div class="col-md-4">
                    <label class="small fw-bold text-muted">First Name</label>
                    <input type="text" class="form-control form-control-sm" value="@customer?.firstname" readonly>
                </div>
                <div class="col-md-4">
                    <label class="small fw-bold text-muted">Middle Name</label>
                    <input type="text" class="form-control form-control-sm" value="@customer?.middlename" readonly>
                </div>
                <div class="col-md-4">
                    <label class="small fw-bold text-muted">Last Name</label>
                    <input type="text" class="form-control form-control-sm" value="@customer?.lastname" readonly>
                </div>
                <div class="col-md-4">
                    <label class="small fw-bold text-muted">Gender</label>
                    <input type="text" class="form-control form-control-sm bg-light" value="@customer?.gender" readonly>
                </div>
                <div class="col-md-4">
                    <label class="small fw-bold text-muted">Nationality</label>
                    <input type="text" class="form-control form-control-sm bg-light" value="@customer?.nationallity" readonly>
                </div>
            </div>

            <p class="fw-bold text-dark border-start border-success border-4 ps-2 mb-3">Demographics & Status</p>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="small fw-bold text-muted">Date of Birth</label>
                    <input type="text" class="form-control form-control-sm" value="@customer?.dob" readonly>
                </div>
                <div class="col-md-2">
                    <label class="small fw-bold text-muted">Age</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" value="@customer?.age" readonly>
                        <span class="input-group-text">Yrs</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="small fw-bold text-muted">Marital Status</label>
                    <input type="text" class="form-control form-control-sm" value="@customer?.maritalStatus" readonly>
                </div>
                <div class="col-md-3">
                    <label class="small fw-bold text-muted">Dependants</label>
                    <input type="text" class="form-control form-control-sm" value="@customer?.numbOfDependant" readonly>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="docStatus" role="tabpanel">
            <div id="docStatusContainer">
                <div class="text-center py-5 doc-loader">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Fetching document metadata...</p>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="covenantStatus" role="tabpanel">
            <div id="covenantStatusContainer">
                <div class="text-center py-5 covenant-loader">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="mt-2 text-muted">Fetching covenant details...</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        @if (Model.loan != null)
        {
            <partial name="_LoanDetailsPartial" model="Model.loan" />
        }
    </div>
</div>

<script>
    // Existing Document Loader
    function loadDocuments(batchId) {
        if (!batchId || batchId === '00000000-0000-0000-0000-000000000000') {
            console.error("Invalid Batch ID");
            return;
        }
        const container = $('#docStatusContainer');
        const tabPane = $('#docStatus');
        if (tabPane.data('loaded') === true) return;

        $.ajax({
            url: '@Url.Action("GetDocumentStatus", "Dashboard")',
            type: 'GET',
            data: { batchId: batchId },
            success: function (result) {
                container.html(result);
                tabPane.data('loaded', true);
            },
            error: function (xhr, status, error) {
                container.html('<div class="alert alert-danger">Error: ' + error + '</div>');
            }
        });
    }

    // New Covenant Loader
    function loadCovenants(appId) {
        if (!appId || appId === '00000000-0000-0000-0000-000000000000') {
            console.error("Invalid Application ID");
            return;
        }
        const container = $('#covenantStatusContainer');
        const tabPane = $('#covenantStatus');

        // Prevent reloading if already loaded
        if (tabPane.data('loaded') === true) return;

        $.ajax({
            url: '@Url.Action("GetCovenantStatus", "Dashboard")',
            type: 'GET',
            data: { appId: appId },
            beforeSend: function() {
                console.log("Fetching covenants for app:", appId);
            },
            success: function (result) {
                container.html(result);
                tabPane.data('loaded', true);
            },
            error: function (xhr, status, error) {
                console.error("Covenant Error:", error);
                container.html('<div class="alert alert-danger">Error loading covenants: ' + error + '</div>');
            }
        });
    }
</script>

<style>
    /* Styling for the new tab and loader consistency */
    .nav-tabs .nav-link.active {
        background-color: transparent;
        color: #0d6efd;
        border-bottom: 3px solid #0d6efd;
    }

    .spinner-border.text-success {
        color: #198754 !important;
    }
</style>