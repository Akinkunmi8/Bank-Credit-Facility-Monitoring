@model Credit_Monitor.ViewModel.PendingLoanWithCustomerDetailsViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Customer Credit Profile";
    var loan = Model.loan;
    var customer = Model.customer;
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Guest";
    var activeforAOBM = "";
    var activeForCM = " ";
    if (userRole == "AO" || userRole == "BM")
    {
         activeforAOBM = "active";
    }
    else if (userRole == "CMO" || userRole == "CMS")
    {
         activeForCM = "active";
    }
}

<style>
    /* ===== Banking UI Enhancements ===== */
    .page-header {
        position: sticky;
        top: 0;
        z-index: 1020;
        background: #fff;
        border-bottom: 1px solid #e9ecef;
    }

    .info-label {
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #6c757d;
        font-weight: 600;
    }

    .info-value {
        font-weight: 500;
        font-size: .875rem;
    }

    .section-title {
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        font-weight: 700;
        color: #0d6efd;
        border-left: 4px solid #0d6efd;
        padding-left: .5rem;
        margin-bottom: 1rem;
    }

    .nav-tabs .nav-link {
        border: none;
        color: #6c757d;
    }

        .nav-tabs .nav-link.active {
            color: #0d6efd;
            background: transparent;
            border-bottom: 3px solid #0d6efd;
        }

    .profile-card {
        border-radius: 12px;
    }
</style>

<!-- ===== Sticky Header ===== -->
<div class="page-header py-3 mb-4 shadow-sm">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-md-4">
                <small class="info-label">Application ID</small>
                <div class="fw-bold text-primary">@loan?.id</div>
            </div>
            <div class="col-md-4 text-center">
                <small class="info-label">Applicant Name</small>
                <div class="fw-bold text-primary">@loan?.accounT_NAME</div>
            </div>
            <div class="col-md-4 text-end">
                <small class="info-label">Stage</small>
                <div class="fw-bold text-success">Post-Disbursement</div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-2">
            @if (userRole == "CMS" && loan!.confirmed && !loan!.approved)
            {
                <form asp-action="UpdateStatus" asp-controller="Dashboard" method="post">
                    <input type="hidden" name="applicationId" value="@loan?.id" />
                    <input type="hidden" name="actionType" value="approve" />
                    <input type="hidden" name="returnDashboard" value="CMSDashboard" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                    <button type="submit" class="btn btn-success btn-sm fw-bold px-3">
                        <i class="bi bi-check-circle-fill me-1"></i> Approve
                    </button>
                </form>
            }
            else if(userRole == "CMO" && !loan!.confirmed)
            {
                <a asp-action="ValidateCAT"
                   asp-controller="Loan"
                   asp-route-AccNum="@loan?.accounT_NUMBER"
                   class="btn btn-warning btn-sm fw-bold px-3">
                    <i class="bi bi-shield-check me-1"></i> Validate CAT
                </a>
            }
            <button onclick="history.back()" class="btn btn-outline-secondary btn-sm px-3">
                <i class="bi bi-arrow-left"></i> Back
            </button>
        </div>
    </div>
</div>

<div class="container-fluid">

    <!-- ===== Tabs ===== -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(userRole != "AO" && userRole != "BM" ? "active" : "") fw-bold small"
                    data-bs-toggle="tab"
                    data-bs-target="#basicInfo">
                Customer Profile
            </button>
        </li>

        @if (userRole == "AO" || userRole == "BM")
        {
            <li class="nav-item">
                <button class="nav-link active fw-bold small"
                        data-bs-toggle="tab"
                        data-bs-target="#discrepancyAnalysis"
                        onclick="loadDiscrepancies('@loan?.accounT_NUMBER')">
                    Discrepancy Analysis
                </button>
            </li>
        }
        <li class="nav-item">
            <button class="nav-link fw-bold small"
                    data-bs-toggle="tab"
                    data-bs-target="#docStatus"
                    onclick="loadDocuments('@loan?.id','@userRole')">
                Document Status
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold small"
                    data-bs-toggle="tab"
                    data-bs-target="#covenantStatus"
                    onclick="loadCovenants('@loan?.id')">
                Covenant Tracker
            </button>
        </li>
    </ul>

    <div class="tab-content bg-white p-3 shadow-sm profile-card">

        <!-- ===== BASIC INFO ===== -->
        <div class="tab-pane fade @(userRole == "CMO" || userRole == "CMS" ? "show active" : "")" id="basicInfo">
            <div class="section-title">Identity & Personal Information</div>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="info-label">Title</div>
                    <div class="info-value">@customer?.tittle</div>
                </div>
                <div class="col-md-3">
                    <div class="info-label">First Name</div>
                    <div class="info-value">@customer?.firstname</div>
                </div>
                <div class="col-md-3">
                    <div class="info-label">Middle Name</div>
                    <div class="info-value">@customer?.middlename</div>
                </div>
                <div class="col-md-3">
                    <div class="info-label">Last Name</div>
                    <div class="info-value">@customer?.lastname</div>
                </div>
                <div class="col-md-3">
                    <div class="info-label">Gender</div>
                    <div class="info-value">@customer?.gender</div>
                </div>
                <div class="col-md-3">
                    <div class="info-label">Nationality</div>
                    <div class="info-value">@customer?.nationallity</div>
                </div>
            </div>

            <div class="section-title">Demographics & Status</div>
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="info-label">Date of Birth</div>
                    <div class="info-value">@customer?.dob</div>
                </div>
                <div class="col-md-2">
                    <div class="info-label">Age</div>
                    <div class="info-value">@customer?.age Yrs</div>
                </div>
                <div class="col-md-3">
                    <div class="info-label">Marital Status</div>
                    <div class="info-value">@customer?.maritalStatus</div>
                </div>
                <div class="col-md-2">
                    <div class="info-label">Dependants</div>
                    <div class="info-value">@customer?.numbOfDependant</div>
                </div>
            </div>
        </div>

        <!-- ===== DOCUMENT STATUS ===== -->
        <div class="tab-pane fade" id="docStatus">
            <div id="docStatusContainer" class="text-center">
                <div class="spinner-border text-primary"></div>
                <p class="text-muted mt-2">Loading document status…</p>
            </div>
        </div>

        <!-- ===== COVENANT STATUS ===== -->
        <div class="tab-pane fade" id="covenantStatus">
            <div id="covenantStatusContainer" class="text-center">
                <div class="spinner-border text-success"></div>
                <p class="text-muted mt-2">Loading covenant tracker…</p>
            </div>
        </div>

        <!-- ==== DISCREPANCY STATUS ===== -->
        @if (userRole == "AO" || userRole == "BM")
        {
            <div class="tab-pane fade show active" id="discrepancyAnalysis">
                <div id="discrepancyContainer" class="text-center">
                    <div class="spinner-border text-danger"></div>
                    <p class="text-muted mt-2">Analyzing system mismatches…</p>
                </div>
                @* Auto-load since it's the active tab *@
                <script>
                    document.addEventListener("DOMContentLoaded", function() {
                        loadDiscrepancies('@loan?.accounT_NUMBER');
                    });
                </script>
            </div>
        }

    </div>

    <!-- ===== LOAN DETAILS ===== -->
    <div class="mt-4">
        @if (loan != null)
        {
            <partial name="_LoanDetailsPartial" model="loan" />
        }
    </div>
</div>


<script>
    function loadDocuments(appId, role) {
        // 1. Guard against null/empty GUIDs
        if (!appId || appId === '00000000-0000-0000-0000-000000000000' || appId === '') {
            console.warn("File API: No AppId provided for document lookup.");
            $('#docStatusContainer').html(`
                <div class="text-center py-4">
                    <i class="bi bi-exclamation-circle text-warning fs-2"></i>
                    <p class="text-muted mt-2">No application ID associated with this record.</p>
                </div>`);
            return;
        }

        const container = $('#docStatusContainer');
        const tabPane = $('#docStatus');

        // 2. Prevent redundant API calls if data is already there
        if (tabPane.data('loaded') === true) return;

        $.ajax({
            url: '@Url.Action("GetDocumentStatus", "Dashboard")',
            type: 'GET',
            data: { appId: appId, role : role }, 
            beforeSend: function () {
                // Show the spinner while waiting
                container.html(`
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">Checking for documents...</p>
                    </div>`);
            },
            success: function (result) {
                // result will be the HTML from the Partial View
                container.hide().html(result).fadeIn(300);
                tabPane.data('loaded', true);
            },
            error: function (xhr, status, error) {
                tabPane.data('loaded', false); // Allow retry
                container.html(`
                    <div class="alert alert-danger d-flex align-items-center m-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div>Error loading documents: ${error}</div>
                    </div>`);
            }
        });
    }
    // Discrepancies Loader
    function loadDiscrepancies(accNum) {
        if (!accNum) return;

        const container = $('#discrepancyContainer');
        const tabPane = $('#discrepancyAnalysis');
        const confirmBtn = $('#btnConfirmResolution');

        // Pass the C# variable to a JS constant
        const currentUserRole = '@userRole';

        if (tabPane.data('loaded') === true) return;

        $.ajax({
            url: '@Url.Action("GetDiscrepancyStatus", "Dashboard")',
            type: 'GET',
            data: { accNum: accNum },
            success: function (result) {
                container.html(result);
                tabPane.data('loaded', true);

            },
            error: function () {
                container.html('<div class="alert alert-danger">Failed to load analysis.</div>');
            }
        });
    }

    // New Covenant Loader
    function loadCovenants(appId) {
        if (!appId || appId === '00000000-0000-0000-0000-000000000000') {
            console.error("Invalid Application ID");
            return;
        }
        const container = $('#covenantStatusContainer');
        const tabPane = $('#covenantStatus');

        // Prevent reloading if already loaded
        if (tabPane.data('loaded') === true) return;

        $.ajax({
            url: '@Url.Action("GetCovenantStatus", "Dashboard")',
            type: 'GET',
            data: { appId: appId },
            beforeSend: function() {
                console.log("Fetching covenants for app:", appId);
            },
            success: function (result) {
                container.html(result);
                tabPane.data('loaded', true);
            },
            error: function (xhr, status, error) {
                console.error("Covenant Error:", error);
                container.html('<div class="alert alert-danger">Error loading covenants: ' + error + '</div>');
            }
        });
    }
</script>

<style>
    /* Styling for the new tab and loader consistency */
    .nav-tabs .nav-link.active {
        background-color: transparent;
        color: #0d6efd;
        border-bottom: 3px solid #0d6efd;
    }

    .spinner-border.text-success {
        color: #198754 !important;
    }
</style>