@using Credit_Monitor.ViewModel
@model CreditMonitoringReportViewModel

@{
    ViewData["Title"] = "Credit Monitoring Review Report";

    var loan = Model.CreditProfile.loan;
    var customer = Model.CreditProfile.customer;
}

<style>
    .report-wrapper {
        max-width: 1250px;
        margin: 25px auto 80px;
    }

    .report-document {
        background: #fff;
        border: 1px solid #e5e7eb;
        box-shadow: 0 4px 18px rgba(0,0,0,.06);
    }

    .report-header {
        padding: 28px 32px;
        border-bottom: 4px solid #0d6efd;
    }

    .report-body {
        padding: 30px 32px;
    }

    .report-section {
        margin-bottom: 32px;
        page-break-inside: avoid;
    }

    .section-heading {
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        font-weight: 700;
        color: #0d6efd;
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 8px;
        margin-bottom: 18px;
    }

    .report-label {
        font-size: .7rem;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 600;
        margin-bottom: 3px;
    }

    .report-value {
        font-size: .9rem;
        font-weight: 600;
        color: #212529;
    }

    .report-meta {
        font-size: .8rem;
        color: #6c757d;
    }

    @@media print {
        header,
        footer,
        .no-print {
            display: none !important;
        }

        body {
            background: #fff !important;
        }

        .report-wrapper {
            margin: 0;
            max-width: 100%;
        }

        .report-document {
            border: none;
            box-shadow: none;
        }
    }
</style>


<div class="report-wrapper">

    <!-- ACTIONS -->
    <div class="d-flex justify-content-between mb-3 no-print">

        <button class="btn btn-outline-secondary"
                onclick="history.back()">
            <i class="bi bi-arrow-left me-1"></i>
            Back
        </button>

        <div class="d-flex gap-2">

            <button class="btn btn-outline-dark"
                    onclick="window.print()">
                <i class="bi bi-printer me-1"></i>
                Print
            </button>

            <a asp-controller="Dashboard"
               asp-action="DownloadCreditReport"
               asp-route-id="@loan?.id"
               class="btn btn-danger">

                <i class="bi bi-file-earmark-pdf me-1"></i>
                Download PDF
            </a>

        </div>

    </div>


    <div class="report-document">

        <!-- REPORT HEADER -->
        <div class="report-header">

            <div class="d-flex justify-content-between">

                <div>
                    <div class="text-primary fw-bold small">
                        CREDIT MONITOR
                    </div>

                    <h3 class="fw-bold mb-1">
                        Credit Monitoring Review Report
                    </h3>

                    <div class="text-muted">
                        Post-Disbursement Credit Monitoring
                    </div>
                </div>

                <div class="text-end report-meta">

                    <div>
                        <strong>Application ID</strong>
                    </div>

                    <div class="text-primary fw-bold">
                        @loan?.id
                    </div>

                    <div class="mt-2">
                        Generated:
                        @Model.GeneratedAt.ToString("dd MMM yyyy HH:mm")
                    </div>

                    <div>
                        Generated By:
                        @Model.GeneratedBy
                    </div>

                </div>

            </div>

        </div>


        <div class="report-body">

            <!-- CUSTOMER DETAILS -->
            <section class="report-section">

                <div class="section-heading">
                    01. Customer Details
                </div>

                <div class="row g-4">

                    <div class="col-md-3">
                        <div class="report-label">Title</div>
                        <div class="report-value">
                            @customer?.tittle
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="report-label">First Name</div>
                        <div class="report-value">
                            @customer?.firstname
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="report-label">Middle Name</div>
                        <div class="report-value">
                            @customer?.middlename
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="report-label">Last Name</div>
                        <div class="report-value">
                            @customer?.lastname
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="report-label">Gender</div>
                        <div class="report-value">
                            @customer?.gender
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="report-label">Nationality</div>
                        <div class="report-value">
                            @customer?.nationallity
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="report-label">Date of Birth</div>
                        <div class="report-value">
                            @customer?.dob
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="report-label">Age</div>
                        <div class="report-value">
                            @customer?.age Years
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="report-label">Marital Status</div>
                        <div class="report-value">
                            @customer?.maritalStatus
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="report-label">Dependants</div>
                        <div class="report-value">
                            @customer?.numbOfDependant
                        </div>
                    </div>

                </div>

            </section>


            <!-- LOAN DETAILS -->
            <section class="report-section">

                <div class="section-heading">
                    02. Loan / Facility Details
                </div>

                @if (loan != null)
                {
                    <partial name="_LoanDetailsPartial"
                             model="loan" />
                }

            </section>


            <!-- DOCUMENT STATUS -->
            <section class="report-section">

                <div class="section-heading">
                    03. Document Verification Status
                </div>

                @if (Model.Documents != null &&
                     Model.Documents.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-light">
                                <tr>
                                    <th>Document</th>
                                    <th>Category</th>
                                    <th class="text-center">
                                        Verification Status
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var doc in Model.Documents)
                                {
                                    <tr>

                                        <td class="fw-semibold">
                                            @doc.FileName
                                        </td>

                                        <td>
                                            @doc.DocType
                                        </td>

                                        <td class="text-center">

                                            @if (doc.IsVerified)
                                            {
                                                <span class="badge bg-success">
                                                    Verified
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Pending Verification
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="alert alert-light border">
                        No documents available for this application.
                    </div>
                }

            </section>


            <!-- COVENANT TRACKER -->
            <section class="report-section">

                <div class="section-heading">
                    04. Covenant Tracker
                </div>

                <h6 class="fw-bold mb-3">
                    Financial Covenants
                </h6>

                @if (Model.Covenants?.Financials?.Any() == true)
                {
                    <div class="table-responsive mb-4">

                        <table class="table table-bordered align-middle">

                            <thead class="table-light">
                                <tr>
                                    <th>Type</th>
                                    <th>Description</th>
                                    <th>Target</th>
                                    <th>Frequency</th>
                                    <th>Source</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.Covenants.Financials)
                                {
                                    <tr>
                                        <td>@item.CovenantType</td>
                                        <td>@item.Description</td>
                                        <td>@item.TargetValue</td>
                                        <td>@item.Frequency</td>
                                        <td>@item.DataSource</td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <p class="text-muted">
                        No financial covenants recorded.
                    </p>
                }


                <h6 class="fw-bold mb-3">
                    Non-Financial Covenants
                </h6>

                @if (Model.Covenants?.NonFinancials?.Any() == true)
                {
                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-light">
                                <tr>
                                    <th>Compliance Type</th>
                                    <th>Description</th>
                                    <th>Frequency</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.Covenants.NonFinancials)
                                {
                                    <tr>
                                        <td>@item.CovenantType</td>
                                        <td>@item.Description</td>
                                        <td>@item.Frequency</td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <p class="text-muted">
                        No non-financial covenants recorded.
                    </p>
                }

            </section>


            <!-- APPROVAL -->
            <section class="report-section">

                <div class="section-heading">
                    05. Review & Approval Status
                </div>

                <div class="alert alert-success mb-0">

                    <div class="d-flex align-items-center">

                        <i class="bi bi-patch-check-fill fs-3 me-3"></i>

                        <div>
                            <div class="fw-bold">
                                CMS Approved
                            </div>

                            <small>
                                This facility has completed the
                                Credit Monitoring review and approval workflow.
                            </small>
                        </div>

                    </div>

                </div>

            </section>

        </div>

    </div>

</div>