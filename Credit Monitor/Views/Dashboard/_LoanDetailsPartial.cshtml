@model Credit_Monitor.ViewModel.PendingConfirmedLoanViewModel

<style>
    .section-header {
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: #0d6efd;
        border-left: 4px solid #0d6efd;
        padding-left: .5rem;
        margin-bottom: 1rem;
    }

    .info-box {
        background: #f8f9fa;
        border-radius: 10px;
        padding: .75rem .9rem;
        height: 100%;
    }

    .info-label {
        font-size: .65rem;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 600;
        margin-bottom: .2rem;
    }

    .info-value {
        font-weight: 600;
        font-size: .85rem;
        color: #212529;
        white-space: nowrap;
    }

    .risk-high {
        color: #dc3545;
        font-weight: 700;
    }

    .risk-good {
        color: #198754;
        font-weight: 700;
    }
</style>

<!-- ================= HEADER ================= -->
<div class="d-flex justify-content-between align-items-center mt-5 mb-4">
    <h6 class="fw-bold text-success mb-0">
        <i class="bi bi-cash-stack me-2"></i> Loan Financial Position
    </h6>
</div>

<!-- ================= ACCOUNT & SECTOR ================= -->
<div class="section-header">Account & Sector Identifiers</div>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Account Number</div>
            <div class="info-value">@Model.accounT_NUMBER</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Contract ID / ACID</div>
            <div class="info-value">@Model.contracT_ID / @Model.contracT_ACID</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Customer / Group ID</div>
            <div class="info-value">@Model.customeR_ID / @Model.grouP_ID</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Scheme / GL Asset</div>
            <div class="info-value">@Model.schM_CODE – @Model.gL_ASSET</div>
        </div>
    </div>
</div>

<!-- ================= FINANCIAL BALANCES ================= -->
<div class="section-header">Financial Balances & Rates</div>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Sanction / TOD Limit</div>
            <div class="info-value">
                @Model.sanctioN_LIMIT.ToString("N2") /
                @Model.toD_LIMIT.ToString("N2")
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Loan Balance (LCY / FCY)</div>
            <div class="info-value risk-high">
                @Model.loaN_BALANCE_LCY.ToString("N2") /
                @Model.loaN_BALANCE_FCY.ToString("N2")
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Operative Balance</div>
            <div class="info-value risk-good">
                @Model.operativE_ACCT_BALANCE_LCY.ToString("N2")
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Interest / FX Rate</div>
            <div class="info-value">
                @Model.inT_RATE% / @Model.fX_RATE
            </div>
        </div>
    </div>
</div>

<!-- ================= REPAYMENT ================= -->
<div class="section-header">Repayment & Collection Analysis</div>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Instalment</div>
            <div class="info-value">@Model.instalment.ToString("N2")</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Cumulative Paid</div>
            <div class="info-value risk-good">
                @Model.cuM_PRINCIPAL_REPAYMENT_AMOUNT_PAID?.ToString("N2")
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Due Not Paid</div>
            <div class="info-value risk-high">
                @Model.cuM_PRINCIPAL_DUE_NOT_YET_PAID?.ToString("N2")
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Overdue Amount</div>
            <div class="info-value @(Model.overduE_AMT > 0 ? "risk-high" : "risk-good")">
                @Model.overduE_AMT?.ToString("N2")
            </div>
        </div>
    </div>
</div>

<!-- ================= RISK & TIMELINE ================= -->
<div class="section-header">Risk, Performance & Timeline</div>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Risk Rating</div>
            <div class="info-value @(Model.riskrating?.Contains("A") == true ? "risk-good" : "risk-high")">
                @Model.riskrating
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Performance Class</div>
            <div class="info-value text-primary">@Model.performancE_CLASS_DESC</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Past Due (Days)</div>
            <div class="info-value">@Model.dayS_PAST_DUE</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Expiry Date</div>
            <div class="info-value">@Model.expirY_DATE.ToString("dd MMM yyyy")</div>
        </div>
    </div>
</div>

<!-- ================= BRANCH & STAFF ================= -->
<div class="section-header">Branch, Region & Officers</div>
<div class="row g-3">
    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Branch</div>
            <div class="info-value">@Model.brancH_NAME</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Account Officer</div>
            <div class="info-value">@Model.accounT_OFFICER</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">BM / BOM</div>
            <div class="info-value">@Model.bM_STAFF_NAME / @Model.boM_STAFF_NAME</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="info-box">
            <div class="info-label">Directorate</div>
            <div class="info-value">@Model.directoratE_NAME</div>
        </div>
    </div>
</div>
