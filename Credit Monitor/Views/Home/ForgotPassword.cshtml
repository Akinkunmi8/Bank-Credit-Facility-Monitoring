@model Credit_Monitor.ViewModel.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

@section Styles {
    <style>
        body {
            background: url('/images/bankwallpaper.jpg') no-repeat center center fixed;
            background-size: cover;
        }

        .login-overlay {
            min-height: 100vh;
            background: rgba(0, 0, 0, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .back-link {
            color: #0d6efd;
            text-decoration: none;
            font-weight: 600;
        }

            .back-link:hover {
                text-decoration: underline;
            }
    </style>
}

<div class="login-overlay">
    <div class="row justify-content-center align-items-center w-100">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h4 class="mb-0 fw-bold">Reset Password</h4>
                    <p class="mb-0 opacity-75 small">Credit Monitor Security</p>
                </div>

                <div class="card-body p-4">
                    <div id="apiResponseAlert" class="alert d-none small mb-3"></div>

                    <form id="forgotPasswordForm">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" id="emailInput" class="form-control" placeholder="user@gmail.com" required />
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" id="btnConfirmEmail" class="btn btn-primary btn-lg">
                                <span id="btnText">Confirm Email</span>
                                <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light text-center py-3">
                    <a asp-action="Login" class="text-decoration-none small fw-bold">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('forgotPasswordForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const email = document.getElementById('emailInput').value;
            const btn = document.getElementById('btnConfirmEmail');
            const btnText = document.getElementById('btnText');
            const btnSpinner = document.getElementById('btnSpinner');
            const alertBox = document.getElementById('apiResponseAlert');

            // UI Loading State
            btn.disabled = true;
            btnText.innerText = "Processing...";
            btnSpinner.classList.remove('d-none');
            alertBox.classList.add('d-none');

            // AJAX Call
            fetch('/Home/ForgotPasswordApi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email })
            })
            .then(response => response.json())
            .then(data => {
                // 'data' reflects your Newtonsoft JSON structure
                alertBox.innerText = data.responseMessage;
                alertBox.classList.remove('d-none');

                if (data.isSuccess) {
                    alertBox.classList.replace('alert-danger', 'alert-success');
                    alertBox.classList.add('alert-success');
                    // Optional: Clear form on success
                    document.getElementById('forgotPasswordForm').reset();
                } else {
                    alertBox.classList.add('alert-danger');
                }
            })
            .catch(error => {
                alertBox.innerText = "An error occurred. Please try again.";
                alertBox.classList.remove('d-none', 'alert-success');
                alertBox.classList.add('alert-danger');
            })
            .finally(() => {
                // Restore Button State
                btn.disabled = false;
                btnText.innerText = "Confirm Email";
                btnSpinner.classList.add('d-none');
            });
        });
    </script>
}