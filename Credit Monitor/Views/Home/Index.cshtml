@{
    ViewData["Title"] = "Home";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
    var region = User.FindFirst("Region")?.Value ?? "N/A";
}

<div class="container py-5">
    <div class="row align-items-center mb-5">
        <div class="col-lg-7">
            <h1 class="display-3 fw-bold text-primary mb-3">Credit Monitor <span class="text-dark">v1.0</span></h1>
            <p class="lead text-muted fs-4">
                The centralized portal for managing loan confirmations, credit assessments, and regional portfolio performance.
            </p>

            @if (isAuthenticated)
            {
                <div class="d-flex align-items-center mt-4 p-3 bg-light rounded-3 border-start border-primary border-4 shadow-sm">
                    <div class="flex-shrink-0">
                        <i class="bi bi-person-badge fs-1 text-primary"></i>
                    </div>
                    <div class="ms-3">
                        <h5 class="mb-0">Welcome back, @User.Identity.Name!</h5>
                        <p class="mb-0 text-muted">Signed in as <strong>@userRole</strong> | Region: <strong>@region</strong></p>
                    </div>
                </div>
            }
            else
            {
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Login" class="btn btn-primary btn-lg px-5 shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Access Portal
                    </a>
                </div>
            }
        </div>
        <div class="col-lg-5 d-none d-lg-block">
            <div class="p-5 bg-primary bg-gradient rounded-circle opacity-10 shadow-lg position-relative" style="width: 400px; height: 400px;">
                <i class="bi bi-graph-up-arrow position-absolute top-50 start-50 translate-middle text-primary" style="font-size: 150px;"></i>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm transition-hover">
                <div class="card-body p-4">
                    <div class="feature-icon bg-primary bg-gradient text-white rounded-3 mb-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-speedometer2 fs-4"></i>
                    </div>
                    <h4 class="fw-bold">Go to Dashboard</h4>
                    <p class="text-muted">Access your personalized workspace to manage pending and confirmed loans for your region.</p>
                    <a asp-controller="Dashboard" asp-action="@(userRole == "Supervisor" ? "Supervisor" : "Staff")" class="stretched-link text-primary fw-bold text-decoration-none">Open Dashboard <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm transition-hover">
                <div class="card-body p-4">
                    <div class="feature-icon bg-success bg-gradient text-white rounded-3 mb-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-file-earmark-check fs-4"></i>
                    </div>
                    <h4 class="fw-bold">CAT Portal</h4>
                    <p class="text-muted">Perform detailed Credit Assessment Tool (CAT) reviews and updates for new loan applications.</p>
                    <a href="#" class="stretched-link text-success fw-bold text-decoration-none">Launch CAT <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm transition-hover">
                <div class="card-body p-4">
                    <div class="feature-icon bg-dark bg-gradient text-white rounded-3 mb-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-shield-lock fs-4"></i>
                    </div>
                    <h4 class="fw-bold">User Profile</h4>
                    <p class="text-muted">Manage your security credentials, update your profile settings, or view system logs.</p>
                    <a href="#" class="stretched-link text-dark fw-bold text-decoration-none">Manage Account <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-hover:hover {
        transform: translateY(-10px);
        transition: transform 0.3s ease;
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
    }

    .bg-gradient {
        background: linear-gradient(45deg, rgba(255,255,255,.15), rgba(255,255,255,0));
    }
</style>