@{
    ViewData["Title"] = "Home";

    bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    string userRole = User.Claims
        .FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest";
    string region = User.FindFirst("Region")?.Value ?? "N/A";
}

<div class="home-hero">
    <div class="container py-5">

        <!-- HERO SECTION -->
        <div class="row align-items-center mb-5">
            <div class="col-lg-7">
                <h1 class="display-4 fw-bold text-primary mb-3">
                    Credit Monitor <span class="text-dark fs-3">v1.0</span>
                </h1>

                <p class="lead text-muted fs-5">
                    Centralized platform for loan confirmations, credit assessment,
                    and regional portfolio monitoring.
                </p>

                @if (isAuthenticated)
                {
                    <div class="welcome-box mt-4">
                        <i class="bi bi-person-badge fs-1 text-primary"></i>
                        <div class="ms-3">
                            <h6 class="mb-1">Welcome back, @User.Identity!.Name</h6>
                            <small class="text-muted">
                                Role: <strong>@userRole</strong> | Region: <strong>@region</strong>
                            </small>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Home"
                       asp-action="Login"
                       class="btn btn-primary btn-lg mt-4 px-5 shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Access Portal
                    </a>
                }
            </div>
        </div>

        <!-- FEATURE CARDS -->
        <div class="row g-4 mt-4">

            <!-- DASHBOARD -->
            <div class="col-md-4">
                <div class="feature-card dashboard-card">
                    <div class="card-body">
                        <h4>Dashboard</h4>
                        <p>Manage pending and confirmed loans by region.</p>
                        <a asp-controller="Dashboard"
                           asp-action="@(userRole == "Supervisor" ? "Supervisor" : "Staff")"
                           class="stretched-link">
                            Open Dashboard <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- CAT -->
            <div class="col-md-4">
                <div class="feature-card cat-card">
                    <div class="card-body">
                        <h4>CAT Portal</h4>
                        <p>Run Credit Assessment Tool (CAT) reviews.</p>
                        <a href="#" class="stretched-link">
                            Launch CAT <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- PROFILE -->
            <div class="col-md-4">
                <div class="feature-card profile-card">
                    <div class="card-body">
                        <h4>User Profile</h4>
                        <p>Manage credentials and security settings.</p>
                        <a href="#" class="stretched-link">
                            Manage Account <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

@section Styles {
    <style>
        /* ================= HERO BACKGROUND ================= */
        .home-hero {
            min-height: 100vh;
            background: linear-gradient(rgba(255,255,255,.92), rgba(255,255,255,.92)), url('/images/index.jpg') center/cover no-repeat;
        }

        /* ================= WELCOME BOX ================= */
        .welcome-box {
            display: flex;
            align-items: center;
            background: #f8f9fa;
            border-left: 5px solid #0d6efd;
            padding: 1rem 1.25rem;
            border-radius: .75rem;
            box-shadow: 0 .25rem .75rem rgba(0,0,0,.08);
        }

        /* ================= FEATURE CARDS ================= */
        .feature-card {
            height: 100%;
            border-radius: 18px;
            overflow: hidden;
            background-size: cover;
            background-position: center;
            position: relative;
            color: #212529;
            transition: all .35s ease;
            box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.12);
        }

            /* FAINT OVERLAY (MATCH HERO STYLE) */
            .feature-card::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient( rgba(255,255,255,.88), rgba(255,255,255,.88) );
                transition: background .35s ease;
            }

            /* CARD CONTENT */
            .feature-card .card-body {
                position: relative;
                z-index: 2;
                padding: 2.2rem;
            }

            .feature-card h4 {
                font-weight: 700;
                color: #0d6efd;
            }

            .feature-card p {
                color: #495057;
            }

            .feature-card a {
                color: #0d6efd;
                font-weight: 600;
                text-decoration: none;
            }

            /* HOVER EFFECT */
            .feature-card:hover {
                transform: translateY(-12px);
                box-shadow: 0 1.5rem 3rem rgba(0,0,0,.2);
            }

                /* IMAGE REVEAL ON HOVER */
                .feature-card:hover::before {
                    background: linear-gradient( rgba(255,255,255,.65), rgba(255,255,255,.65) );
                }

        /* ================= CARD IMAGES ================= */
        .dashboard-card {
            background-image: url('/images/card.jpg');
        }

        .cat-card {
            background-image: url('/images/card2.jpg');
        }

        .profile-card {
            background-image: url('/images/card3.jpg');
        }
    </style>
}
