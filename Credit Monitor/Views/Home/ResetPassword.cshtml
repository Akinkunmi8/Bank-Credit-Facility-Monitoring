@model Credit_Monitor.ViewModel.ResetPasswordViewModel
@{
    Layout = null; // This removes the general header/nav
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - Credit Monitor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background: url('/images/bankwallpaper.jpg') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-overlay {
            min-height: 100vh;
            background: rgba(0, 0, 0, 0.55);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            border-radius: 12px;
            overflow: hidden;
        }

        .strength-meter {
            height: 5px;
            background-color: #e9ecef;
            margin-top: 5px;
            border-radius: 2px;
        }
    </style>
</head>
<body>

    <div class="login-overlay">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-5 col-lg-4">
                    <div class="card shadow-lg border-0">
                        <div class="card-header bg-dark text-white text-center py-4">
                            <h4 class="mb-0 fw-bold">Credit Monitor</h4>
                            <p class="mb-0 opacity-75 small">Secure Password Reset</p>
                        </div>

                        <div class="card-body p-4">
                            <div class="text-center mb-4">
                                <i class="bi bi-shield-lock text-primary" style="font-size: 2.5rem;"></i>
                                <p class="text-muted small mt-2">Please enter your new secure password below.</p>
                            </div>

                            <form asp-action="ResetPassword" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                                <input type="hidden" asp-for="Email" />
                                <input type="hidden" asp-for="Token" />

                                <div class="mb-3">
                                    <label asp-for="NewPassword" class="form-label fw-bold">New Password</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="••••••••" id="passInput" />
                                    </div>
                                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirm Password</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-check2-all"></i></span>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>

                                <div class="d-grid mt-4">
                                    <button type="submit" class="btn btn-primary btn-lg fw-bold">Update Password</button>
                                </div>
                            </form>
                        </div>

                        <div class="card-footer bg-light text-center py-3">
                            <a asp-controller="Home" asp-action="Login" class="text-decoration-none small fw-bold">
                                <i class="bi bi-arrow-left"></i> Back to Login
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>