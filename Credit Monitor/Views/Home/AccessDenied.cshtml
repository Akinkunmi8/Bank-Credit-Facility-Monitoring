@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="card shadow-lg border-0">
            <div class="card-body p-5">
                <div class="mb-4">
                    <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
                </div>

                <h1 class="display-6 fw-bold text-dark">Access Denied</h1>
                <p class="text-muted mb-4">
                    Oops! You don't have the necessary permissions to view this page.
                    Please contact your administrator if you believe this is an error.
                </p>

                <hr class="my-4">

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
                        Back to Home
                    </a>
                    @if (User.IsInRole("Staff"))
                    {
                        <a asp-controller="Dashboard" asp-action="Staff" class="btn btn-primary px-4">
                            Switch Account
                        </a>
                    }
                    @if (User.IsInRole("Supervisor"))
                    {
                        <a asp-controller="Dashboard" asp-action="Supervisor" class="btn btn-primary px-4">
                            Switch Account
                        </a>
                    }
                    @if(!User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Home" asp-action="Login" class="btn btn-outline-secondary px-4">
                            Login
                        </a>
					}

                </div>
            </div>
            <div class="card-footer bg-light py-3">
                <small class="text-muted">Error Code: 403 - Forbidden</small>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}