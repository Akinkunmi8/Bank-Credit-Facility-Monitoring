@model Credit_Monitor.ViewModel.RegisterViewModel
@{
    ViewData["Title"] = "Register New Account";
}

@section Styles {
    <style>
        body {
            background: url('/images/bankwallpaper.jpg') no-repeat center center fixed;
            background-size: cover;
        }

        .register-overlay {
            min-height: 100vh;
            background: rgba(0, 0, 0, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 0;
        }

        .card {
            border-radius: 12px;
        }
    </style>
}

<div class="register-overlay">
    <div class="row justify-content-center align-items-center w-100">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0 fw-bold">Create Account</h4>
                    <p class="mb-0 opacity-75 small">Join the Credit Monitor Portal</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FullName" class="form-label fw-bold small"></label>
                                <input asp-for="FullName" class="form-control" placeholder="John Doe" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-bold small"></label>
                                <input asp-for="Email" class="form-control" placeholder="j.doe@bank.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Region" class="form-label fw-bold small"></label>
                                <select asp-for="Region" class="form-select">
                                    <option value="">-- Select Region --</option>
                                    <option value="NORTH">North</option>
                                    <option value="SOUTH">South</option>
                                    <option value="EAST">East</option>
                                    <option value="WEST">West</option>
                                </select>
                                <span asp-validation-for="Region" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Role" class="form-label fw-bold small"></label>
                                <select asp-for="Role" class="form-select">
                                    <option value="">-- Select Role --</option>
                                    <option value="CMO">Credit Monitor Officer</option>
                                    <option value="CMS">Credit Monitor Supervisor</option>
                                    <option value="AO">Accounting Officer</option>
                                    <option value="BM">Bank Manager</option>
                                 </select>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-3 text-muted" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label fw-bold small"></label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold small"></label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold">Register Account</button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light text-center py-3">
                    <p class="mb-0 small text-dark">
                        Already have an account? 
                        <a asp-action="Login" class="fw-bold text-decoration-none">Sign in here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}