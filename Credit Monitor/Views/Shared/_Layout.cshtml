@using System.Security.Claims
@{
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Guest";
    var dashboard = $"{userRole}Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Credit Monitor</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Credit_Monitor.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	@await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bank2 me-2"></i>CREDIT MONITOR
                </a>
                    <div class="d-flex align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="text-white me-3 d-none d-md-block text-end">
                                <small class="opacity-75 d-block" style="line-height: 1;">Logged in as:</small>
                                <div class="fw-bold">
                                    @User.Identity.Name
                                    <span class="badge rounded-pill bg-white text-primary ms-1" style="font-size: 0.7rem;">
                                        @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                                    </span>
                                </div>
                            </div>
                            <form asp-controller="Home" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-light text-danger fw-bold shadow-sm">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="btn-group shadow-sm">
                                <a class="btn btn-sm btn-light fw-bold" asp-controller="Home" asp-action="Login">
                                    <i class="bi bi-person-fill me-1"></i>Login
                                </a>
                                <a class="btn btn-sm btn-outline-light fw-bold" asp-controller="Home" asp-action="Register">
                                    <i class="bi bi-person-plus-fill me-1"></i>Register
                                </a>
                            </div>
                        }
                    </div>
            </div>
        </nav>

        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm py-0">
            <div class="container-fluid">
                <button class="navbar-toggler my-2" type="button" data-bs-toggle="collapse" data-bs-target="#subNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="subNavbar">
                    <ul class="navbar-nav me-auto align-items-center">
                        <li class="nav-item"> 
                            @if(User.Identity.IsAuthenticated)
                            {
                                <a asp-controller="Dashboard" asp-action="@dashboard" class="nav-link active fw-bold border-bottom border-primary border-3"><i class="bi bi-speedometer2"></i> Dashboard</a>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="Login" class="nav-link active fw-bold border-bottom border-primary border-3"><i class="bi bi-speedometer2"></i> Dashboard</a>
                            }
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item ms-md-4 py-2">
                                <div class="input-group input-group-sm">
                                    <label class="input-group-text bg-light text-muted border-0" for="regionSelect">Region:</label>
                                    <select class="form-select border-0 bg-light fw-bold" id="regionSelect" style="width: 200px;">
                                        <option selected>All Regions</option>
                                        <option value="1">Lagos Main</option>
                                        <option value="2">Abuja Central</option>
                                        <option value="3">Port Harcourt</option>
                                        <option value="4">Kano North</option>
                                    </select>
                                </div>
                            </li>

                            <li class="nav-item dropdown ms-md-3">
                                <a class="nav-link dropdown-toggle fw-bold text-primary" href="#" id="reportDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-file-earmark-arrow-down me-1"></i> Generate Report
                                </a>
                                <ul class="dropdown-menu shadow border-0" aria-labelledby="reportDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="ExportPdf">
                                            <i class="bi bi-file-earmark-pdf text-danger me-2"></i> Download as PDF
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="ExportExcel">
                                            <i class="bi bi-file-earmark-excel text-success me-2"></i> Download as Excel
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="navbar-text small text-muted d-none d-lg-block">
                        <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dd MMM yyyy")
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white fixed-bottom">
        <div class="container-fluid px-4 py-2">
            <div class="row align-items-center">
                <div class="col-md-4 small">
                    <span class="fw-bold text-primary">Credit Monitor</span>
                    <span class="mx-1">|</span>
                    &copy; @DateTime.Now.Year - Internal Use Only
                </div>

                <div class="col-md-4 text-center d-none d-md-block">
                    <span class="badge rounded-pill bg-light text-success border small">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> System Online
                    </span>
                    <span class="small ms-3">
                        <i class="bi bi-geo-alt"></i> @(User.FindFirst("Region")?.Value ?? "Global")
                    </span>
                </div>

                <div class="col-md-4 text-end small">
                    <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted me-3">Privacy Policy</a>
                    <a href="#" class="text-decoration-none text-muted me-3">Support</a>
                    <span class="text-dark fw-bold">v1.0.0</span>
                </div>
            </div>
        </div>
    </footer>
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
        <div id="liveToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i id="toastIcon" class="bi me-2"></i>
                    <span id="toastMessage"></span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1060">
        @if (TempData["SuccessMessage"] != null)
        {
            <div id="successToast" class="toast align-items-center text-white bg-success border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div id="errorToast" class="toast align-items-center text-white bg-danger border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    
    

    <style>
        /* Prevent the footer from overlapping the bottom of your table */
        body {
            margin-bottom: 60px;
        }

        .footer {
            height: 45px;
            line-height: 1.5;
            font-size: 0.85rem;
            z-index: 1030; /* Ensures it stays above page content */
        }
    </style>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var successEl = document.getElementById('successToast');
            if (successEl) {
                new bootstrap.Toast(successEl, { delay: 5000 }).show();
            }

            var errorEl = document.getElementById('errorToast');
            if (errorEl) {
                new bootstrap.Toast(errorEl, { delay: 7000 }).show();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
