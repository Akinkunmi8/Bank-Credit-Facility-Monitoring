@model dynamic

@{
    bool isValid = Model.Result.IsValid;
    // We'll pass these values to the modal via data attributes
    string statusText = isValid ? "Synchronized" : Model.Result.Message;
    string rowClass = isValid ? "" : "table-light";

    string badgeClass = isValid ? "bg-success-subtle text-success border-success" : "bg-danger-subtle text-danger border-danger";
}

<tr class="@rowClass align-middle">
    <td class="ps-3 fw-bold text-secondary small">@Model.Label</td>
    <td class="font-monospace small">@Model.Fin</td>
    <td class="font-monospace small">@Model.Cat</td>

    <td>
        <span class="badge border @badgeClass fw-medium px-2 py-1" style="font-size: 0.75rem;">
            <i class="bi @(isValid ? "bi-check-circle" : "bi-exclamation-circle") me-1"></i>
            @statusText
        </span>
    </td>

    <td class="text-end pe-3">
        <button type="button"
                class="btn btn-sm @(isValid ? "btn-outline-secondary" : "btn-primary")"
                data-bs-toggle="modal"
                data-bs-target="#reviewModal"
                data-label="@Model.Label"
                data-fin="@Model.Fin"
                data-cat="@Model.Cat"
                data-status="@statusText"
                data-isvalid="@isValid.ToString().ToLower()">
            <i class="bi @(isValid ? "bi-eye" : "bi-pencil-square") me-1"></i>
            @(isValid ? "Details" : "Review")
        </button>
    </td>
</tr>

@section Scripts {
    <script>
        // Enable Bootstrap tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });
    </script>
}
