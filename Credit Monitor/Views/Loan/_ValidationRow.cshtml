@model dynamic

@{
    bool isValid = Model.Result.IsValid;
    string rowClass = isValid ? "table-success-subtle" : "table-danger-subtle";
    string iconClass = isValid ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger";
    string statusText = isValid ? "Synchronized" : Model.Result.Message;
}

<tr class="@rowClass align-middle" style="transition: background-color 0.3s;" title="@(!isValid ? statusText : "")">
    <td class="ps-3 fw-bold text-secondary small">@Model.Label</td>
    <td class="font-monospace small">@Model.Fin</td>
    <td class="font-monospace small">@Model.Cat</td>
    <td>
        @if (isValid)
        {
            <span class="badge bg-success text-white small">
                <i class="bi bi-shield-check me-1"></i>@statusText
            </span>
        }
        else
        {
            <span class="badge bg-danger text-white small" data-bs-toggle="tooltip" title="@statusText">
                <i class="bi bi-exclamation-triangle me-1"></i>@statusText
            </span>
        }
    </td>
    <td class="text-center fs-5">
        <i class="bi @iconClass"></i>
    </td>
</tr>

@section Scripts {
    <script>
        // Enable Bootstrap tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });
    </script>
}
