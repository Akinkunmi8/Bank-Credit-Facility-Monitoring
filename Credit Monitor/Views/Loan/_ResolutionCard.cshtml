@model Credit_Monitor.ViewModel.ResolutionItem

<div class="card shadow-sm border-0 mb-4 overflow-hidden
            border-start border-4
            @(Model.IsCMO
                ? (string.IsNullOrEmpty(Model.RecommendedAction)
                    ? "border-danger"
                    : "border-warning")
                : "border-primary")">

    <div class="card-header bg-white py-3 border-bottom
                d-flex justify-content-between align-items-center">

        <h6 class="mb-0 fw-bold text-dark">
            Field: @Model.Label
        </h6>

        @if (Model.IsCMO)
        {
            @if (!string.IsNullOrEmpty(Model.RecommendedAction))
            {
                <span class="badge bg-warning text-dark rounded-pill px-3">
                    <i class="bi bi-clock-history me-1"></i>
                    Reviewing Existing Resolution
                </span>
            }
            else
            {
                <span class="badge bg-danger bg-opacity-10
                             text-danger rounded-pill px-3">
                    Resolution Required
                </span>
            }
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(Model.ResolutionAction))
            {
                <span class="badge bg-success rounded-pill px-3">
                    <i class="bi bi-check-circle me-1"></i>
                    Response Completed
                </span>
            }
            else
            {
                <span class="badge bg-primary rounded-pill px-3">
                    <i class="bi bi-reply me-1"></i>
                    AO/RM Response Required
                </span>
            }
        }

    </div>

    <div class="card-body">

        <!-- CURRENT SOURCE VALUES -->
        <div class="row g-4">

            <div class="col-lg-4">

                <div class="p-3 bg-light rounded border">

                    <div class="mb-3">
                        <small class="text-muted d-block
                                      text-uppercase fw-bold mb-1"
                               style="font-size:0.65rem;">
                            Finacle System
                        </small>

                        <span class="text-dark fw-bold font-monospace">
                            @Model.FinValue
                        </span>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block
                                      text-uppercase fw-bold mb-1"
                               style="font-size:0.65rem;">
                            CAT System
                        </small>

                        <span class="text-dark fw-bold font-monospace">
                            @Model.CatValue
                        </span>
                    </div>

                    <div class="text-danger small fw-medium mt-2">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>
                        @Model.Discrepancy
                    </div>

                </div>

            </div>

            <div class="col-lg-8">

                @if (Model.IsCMO)
                {
                    <!-- ============================ -->
                    <!-- CMO CREATES INSTRUCTION      -->
                    <!-- ============================ -->

                    <input type="hidden"
                           name="Resolutions[@Model.Index].Id"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="Resolutions[@Model.Index].FieldName"
                           value="@Model.FieldName" />

                    <input type="hidden"
                           name="Resolutions[@Model.Index].Discrepancy"
                           value="@Model.Discrepancy" />

                    <div class="row g-3">

                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">
                                Recommended Action
                            </label>

                            <textarea name="Resolutions[@Model.Index].RecommendedAction"
                                      class="form-control form-control-sm"
                                      rows="2"
                                      placeholder="Describe the required corrective action..."
                                      required>@Model.RecommendedAction</textarea>
                        </div>

                        <div class="col-md-6">

                            <label class="form-label small fw-bold mb-1">
                                Responsibility
                            </label>

                            <input type="text"
                                   name="Resolutions[@Model.Index].Responsibility"
                                   class="form-control form-control-sm"
                                   value="@Model.Responsibility"
                                   placeholder="Department or Person"
                                   required />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label small fw-bold mb-1">
                                Remarks
                            </label>

                            <input type="text"
                                   name="Resolutions[@Model.Index].Remarks"
                                   class="form-control form-control-sm"
                                   value="@Model.Remarks"
                                   placeholder="Additional notes..." />

                        </div>

                    </div>
                }
                else
                {
                    <!-- ============================ -->
                    <!-- AO/RM READS CMO INSTRUCTION -->
                    <!-- ============================ -->

                    <div class="bg-light border rounded p-3 mb-4">

                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-person-check-fill
                                      text-primary me-2"></i>

                            <span class="fw-bold text-primary">
                                CMO Instruction
                            </span>
                        </div>

                        <div class="row g-3">

                            <div class="col-12">
                                <small class="text-muted text-uppercase
                                              fw-bold d-block mb-1">
                                    Recommended Action
                                </small>

                                <div class="fw-semibold">
                                    @(Model.RecommendedAction ?? "N/A")
                                </div>
                            </div>

                            <div class="col-md-6">
                                <small class="text-muted text-uppercase
                                              fw-bold d-block mb-1">
                                    Responsibility
                                </small>

                                <div>
                                    @(Model.Responsibility ?? "N/A")
                                </div>
                            </div>

                            <div class="col-md-6">
                                <small class="text-muted text-uppercase
                                              fw-bold d-block mb-1">
                                    CMO Remarks
                                </small>

                                <div>
                                    @(Model.Remarks ?? "N/A")
                                </div>
                            </div>

                        </div>

                    </div>

                    <!-- ============================ -->
                    <!-- AO/RM ENTERS RESPONSE        -->
                    <!-- ============================ -->

                    <input type="hidden"
                           name="Resolutions[@Model.Index].Id"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="Resolutions[@Model.Index].FieldName"
                           value="@Model.FieldName" />

                    <input type="hidden"
                           name="Resolutions[@Model.Index].Discrepancy"
                           value="@Model.Discrepancy" />

                    <div class="border rounded p-3">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <div>
                                <h6 class="fw-bold text-primary mb-1">
                                    <i class="bi bi-reply-fill me-2"></i>
                                    AO/RM Corrective Response
                                </h6>

                                <small class="text-muted">
                                    Explain the action taken to address the CMO instruction.
                                </small>
                            </div>

                            @if (Model.RespondedAt.HasValue)
                            {
                                <span class="badge bg-success">
                                    Previously Saved
                                </span>
                            }

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Corrective Action Taken
                                <span class="text-danger">*</span>
                            </label>

                            <textarea name="Resolutions[@Model.Index].ResolutionAction"
                                      class="form-control"
                                      rows="3"
                                      required
                                      placeholder="Describe the corrective action taken...">@Model.ResolutionAction</textarea>

                        </div>

                        <div>

                            <label class="form-label fw-semibold">
                                Resolution Remarks
                            </label>

                            <textarea name="Resolutions[@Model.Index].ResolutionRemarks"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Provide additional explanation or supporting remarks...">@Model.ResolutionRemarks</textarea>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.RespondedBy))
                        {
                            <div class="small text-muted mt-3">
                                Previous response by
                                <strong>@Model.RespondedBy</strong>

                                @if (Model.RespondedAt.HasValue)
                                {
                                    <span>
                                        on @Model.RespondedAt.Value
                                            .ToLocalTime()
                                            .ToString("dd-MMM-yyyy HH:mm")
                                    </span>
                                }
                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </div>
</div>