@model Credit_Monitor.ViewModel.ValidateCATPageViewModel
@{
    ViewData["Title"] = "CAT Validation Dashboard";
    var accuracy = (1 - ((double)Model.Discrepancies.ErrorCount / Model.Discrepancies.TotalFields)) * 100;
}

<div class="container-fluid py-4">

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h4 class="fw-bold text-dark mb-1">CAT Validation Dashboard</h4>
                    <p class="text-muted mb-0">Comparing Account: <span class="fw-bold text-primary">@Model.Discrepancies.AccNum</span></p>
                </div>
                <div class="text-end">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Accuracy Score</small>
                            <h2 class="@(accuracy == 100 ? "text-success" : "text-danger") fw-bold mb-0">@accuracy.ToString("0")%</h2>
                        </div>
                        <div class="vr me-3" style="height: 40px;"></div>
                        <div>
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Field Mismatches</small>
                            <h2 class="@(Model.Discrepancies.ErrorCount > 0 ? "text-danger" : "text-success") fw-bold mb-0">@Model.Discrepancies.ErrorCount</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-clipboard-check me-2"></i> Detailed Comparison Analysis</h6>
                    <span class="text-muted small">Total Fields: @Model.Discrepancies.TotalFields</span>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-uppercase small fw-bold">
                                <tr>
                                    <th class="ps-4" style="width: 20%;">Field</th>
                                    <th style="width: 20%;">Finacle Value</th>
                                    <th style="width: 20%;">CAT Value</th>
                                    <th style="width: 25%;">Discrepancy Message</th>
                                    <th class="text-center" style="width: 15%;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Customer Name", Fin = Model.FinacleData.AccountName, Cat = Model.CatData.CustomerName, Result = Model.Discrepancies.CustomerName })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Directorate/SBU", Fin = Model.FinacleData.SbuName, Cat = Model.CatData.Directorate, Result = Model.Discrepancies.Directorate })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Facility Type", Fin = Model.FinacleData.FacilityType, Cat = Model.CatData.FacilityType, Result = Model.Discrepancies.FacilityType })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Approval Limit", Fin = Model.FinacleData.SanctionLimit.ToString("N2"), Cat = Model.CatData.ApprovalLimit.ToString("N2"), Result = Model.Discrepancies.ApprovalLimit })

                                @{
                                    decimal finBalance = Model.FinacleData.TotalBalanceLcy == 0 ? Model.FinacleData.TotalBalanceFcy : Model.FinacleData.TotalBalanceLcy;
                                }
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Disbursed Amount", Fin = finBalance.ToString("N2"), Cat = Model.CatData.DisbursementRequired.ToString("N2"), Result = Model.Discrepancies.DisbursmentRequired })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Fees", Fin = Model.FinacleData.FxRate.ToString("N2"), Cat = Model.CatData.Fees.ToString("N2"), Result = Model.Discrepancies.Fee })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Interest Rate", Fin = Model.FinacleData.IntRateDisplay + "%", Cat = Model.CatData.Interest + "%", Result = Model.Discrepancies.Interest })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Value Date", Fin = Model.FinacleData.DateGranted.ToString("dd-MMM-yyyy"), Cat = Model.CatData.ValueDate.ToString("dd-MMM-yyyy"), Result = Model.Discrepancies.ValueDate })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Maturity Date", Fin = Model.FinacleData.ExpiryDate.ToString("dd-MMM-yyyy"), Cat = Model.CatData.MaturityOrExpiry.ToString("dd-MMM-yyyy"), Result = Model.Discrepancies.MaturityDate })
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light py-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            @if (Model.Discrepancies.ErrorCount > 0)
                            {
                                <div class="text-danger fw-bold">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    Attention: Review the discrepancies found above.
                                </div>
                            }
                            else
                            {
                                <div class="text-success fw-bold">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    Success: All data points match.
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" onclick="history.back()" class="btn btn-outline-secondary px-4">Go Back</button>

                            <form asp-action="UpdateStatus" asp-controller="Dashboard" method="post">
                                <input type="hidden" name="applicationId" value="@Model.FinacleData.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <input type="hidden" name="returnDashboard" value="Staff" />

                                @if (Model.Discrepancies.ErrorCount > 0)
                                {
                                    <input type="hidden" name="actionType" value="reject" />
                                    <button type="submit" class="btn btn-danger px-5 fw-bold shadow-sm">Reject & Flag</button>
                                }
                                else
                                {
                                    <input type="hidden" name="actionType" value="confirm" />
                                    <button type="submit" class="btn btn-success px-5 fw-bold shadow-sm">Confirm & Validate</button>
                                }
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 bg-light py-3">
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width:40px; height:40px;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="modalTitle">Field Analysis</h5>
                        <small id="displayLabel" class="text-primary fw-bold text-uppercase" style="font-size: 0.75rem;"></small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body px-4">
                <div class="row g-2 mb-4">
                    <div class="col-12">
                        <div class="p-2 border rounded bg-white shadow-sm">
                            <label class="small text-muted d-block mb-0" style="font-size:0.65rem;">FINACLE VALUE</label>
                            <div id="displayFin" class="fw-bold text-dark font-monospace text-break"></div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-2 border rounded bg-white shadow-sm">
                            <label class="small text-muted d-block mb-0" style="font-size:0.65rem;">CAT VALUE</label>
                            <div id="displayCat" class="fw-bold text-dark font-monospace text-break"></div>
                        </div>
                    </div>
                </div>

                <div id="resolutionFormSection">
                    <form id="discrepancyForm">
                        <input type="hidden" id="api_appId" name="appId" value="@Model.FinacleData.Id" />

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Discrepancy Message</label>
                            <textarea id="api_discrepancies" name="discrepancies" class="form-control bg-light small" rows="2"></textarea>
                        </div>
                        <div class="mb-0">
                            <label class="form-label small fw-bold">Recommended Action</label>
                            <textarea id="api_remarks" name="remarks" class="form-control" rows="3" placeholder="e.g. Update Finacle record to match signed offer letter..."></textarea>
                        </div>
                        <div class="mb-0">
                            <label class="form-label small fw-bold">Responsibility</label>
                            <textarea id="api_remarks" name="remarks" class="form-control" rows="3" placeholder="e.g. Credit Admin - John Doe"></textarea>
                        </div>

                        <div class="mb-0">
                            <label class="form-label small fw-bold">Remarks</label>
                            <textarea id="api_remarks" name="remarks" class="form-control" rows="3" placeholder="Enter additional details here..."></textarea>
                        </div>
                    </form>
                </div>

                <div id="syncMessage" class="alert alert-success d-none mb-0 border-0 shadow-sm">
                    <i class="bi bi-check-circle-fill me-2"></i> Data point is synchronized.
                </div>
            </div>

            <div class="modal-footer border-0 bg-light p-3">
                <button type="button" class="btn btn-link text-muted text-decoration-none px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSubmitResolution" class="btn btn-primary px-4 fw-bold shadow-sm">Submit Resolution</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var modalEl = document.getElementById('reviewModal');
            if (!modalEl) return;

            modalEl.addEventListener('show.bs.modal', function (event) {
                var btn = event.relatedTarget;
                var lbl = btn.getAttribute('data-label');
                var fVal = btn.getAttribute('data-fin');
                var cVal = btn.getAttribute('data-cat');
                var stat = btn.getAttribute('data-status'); // This is the discrepancy message
                var valid = btn.getAttribute('data-isvalid');

                $('#displayLabel').text(lbl);
                $('#displayFin').text(fVal);
                $('#displayCat').text(cVal);

                // Map the mismatch message to the 'discrepancies' API field
                $('#api_discrepancies').val(stat);

                if (valid === 'true') {
                    $('#resolutionFormSection, #btnSubmitResolution').hide();
                    $('#syncMessage').removeClass('d-none');
                    $('#modalTitle').text('View Record');
                } else {
                    $('#resolutionFormSection, #btnSubmitResolution').show();
                    $('#syncMessage').addClass('d-none');
                    $('#modalTitle').text('Resolve Mismatch');
                }
            });

            $('#btnSubmitResolution').on('click', function () {
                // Example of how to structure the data for your API
                var payload = {
                    appId: $('#api_appId').val(),
                    discrepancies: $('#api_discrepancies').val(),
                    remarks: $('#api_remarks').val(),
                    recomendedAction: $('#api_recomendedAction').val(),
                    responsibility: $('#api_responsibility').val()
                };

                console.log("Submitting API Payload:", payload);

                // Add your $.ajax call here using 'payload'

                $('#reviewModal').modal('hide');
            });
        });
    </script>
}