@model Credit_Monitor.ViewModel.ValidateCATPageViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "CAT Validation Dashboard";
    var accuracy = (1 - ((double)Model.Discrepancies.ErrorCount / Model.Discrepancies.TotalFields)) * 100;
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Guest";
    var returnDashboard = userRole + "Dashboard";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        @* <a href="javascript:history.back()" class="text-decoration-none text-muted fw-bold small">
            <i class="bi bi-chevron-left me-1"></i> BACK
        </a> *@
        <a asp-action="CustomerDetails"
           asp-controller="Dashboard"
           asp-route-id="@Model.FinacleData.Id"
           class="text-decoration-none text-muted fw-bold small">
            <i class="bi bi-chevron-left me-1"></i> CUSTOMER DETAILS
        </a>
        @if (Model.Discrepancies.ErrorCount > 0)
        {
            @* This button now points to your new Resolution Center *@
            <a asp-action="ResolutionCenter" asp-route-id="@Model.FinacleData.AccountNumber" class="btn btn-primary btn-sm shadow-sm px-4">
                <i class="bi bi-pencil-square me-2"></i> Go to Resolution Center (@Model.Discrepancies.ErrorCount)
            </a>
        }
    </div>

    @* Score Cards Section *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h4 class="fw-bold text-dark mb-1">CAT Validation Dashboard</h4>
                    <p class="text-muted mb-0">Comparing Account: <span class="fw-bold text-primary">@Model.Discrepancies.AccNum</span></p>
                </div>
                <div class="text-end">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Accuracy Score</small>
                            <h2 class="@(accuracy == 100 ? "text-success" : "text-danger") fw-bold mb-0">@accuracy.ToString("0")%</h2>
                        </div>
                        <div class="vr me-3" style="height: 40px;"></div>
                        <div>
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Field Mismatches</small>
                            <h2 class="@(Model.Discrepancies.ErrorCount > 0 ? "text-danger" : "text-success") fw-bold mb-0">@Model.Discrepancies.ErrorCount</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Table Section *@
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-clipboard-check me-2"></i> Detailed Comparison Analysis</h6>
                    <span class="text-muted small">Total Fields Tracked: @Model.Discrepancies.TotalFields</span>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-uppercase small fw-bold">
                                <tr>
                                    <th class="ps-4" style="width: 20%;">Field Name</th>
                                    <th style="width: 20%;">Finacle Value</th>
                                    <th style="width: 20%;">CAT Value</th>
                                    <th style="width: 30%;">Status / Discrepancy</th>
                                    <th class="text-center" style="width: 10%;">Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Customer Name", Fin = Model.FinacleData.AccountName, Cat = Model.CatData.CustomerName, Result = Model.Discrepancies.CustomerName })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Directorate/SBU", Fin = Model.FinacleData.SbuName, Cat = Model.CatData.Directorate, Result = Model.Discrepancies.Directorate })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Facility Type", Fin = Model.FinacleData.FacilityType, Cat = Model.CatData.FacilityType, Result = Model.Discrepancies.FacilityType })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Approval Limit", Fin = Model.FinacleData.SanctionLimit.ToString("N2"), Cat = Model.CatData.ApprovalLimit.ToString("N2"), Result = Model.Discrepancies.ApprovalLimit })

                                @{
                                    decimal finBalance = Model.FinacleData.TotalBalanceLcy == 0 ? Model.FinacleData.TotalBalanceFcy : Model.FinacleData.TotalBalanceLcy;
                                }
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Disbursed Amount", Fin = finBalance.ToString("N2"), Cat = Model.CatData.DisbursementRequired.ToString("N2"), Result = Model.Discrepancies.DisbursmentRequired })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Fees", Fin = Model.FinacleData.FxRate.ToString("N2"), Cat = Model.CatData.Fees.ToString("N2"), Result = Model.Discrepancies.Fee })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Interest Rate", Fin = Model.FinacleData.IntRateDisplay + "%", Cat = Model.CatData.Interest + "%", Result = Model.Discrepancies.Interest })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Value Date", Fin = Model.FinacleData.DateGranted.ToString("dd-MMM-yyyy"), Cat = Model.CatData.ValueDate.ToString("dd-MMM-yyyy"), Result = Model.Discrepancies.ValueDate })
                                @await Html.PartialAsync("_ValidationRow", new { Label = "Maturity Date", Fin = Model.FinacleData.ExpiryDate.ToString("dd-MMM-yyyy"), Cat = Model.CatData.MaturityOrExpiry.ToString("dd-MMM-yyyy"), Result = Model.Discrepancies.MaturityDate })
                            </tbody>
                        </table>
                    </div>
                </div>

                @* Bottom Footer *@
                <div class="card-footer bg-light py-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            @if (Model.Discrepancies.ErrorCount > 0)
                            {
                                <div class="text-danger fw-bold">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    Mismatches detected. Please proceed to the Resolution Center to document fixes.
                                </div>
                            }
                            else
                            {
                                <div class="text-success fw-bold">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    Validation Complete: Finacle and CAT data are perfectly synchronized.
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            @if (Model.Discrepancies.ErrorCount > 0)
                            {
                                <button type="button" class="btn btn-outline-danger px-4 fw-bold shadow-sm"
                                        data-bs-toggle="modal" data-bs-target="#rejectModal">
                                    <i class="bi bi-x-circle me-2"></i>Reject Application
                                </button>
                            }
                            else
                            {
                                <form asp-action="UpdateStatus" asp-controller="Dashboard" method="post">
                                    <input type="hidden" name="applicationId" value="@Model.FinacleData.Id" />
                                    <input type="hidden" name="actionType" value="confirm" />
                                    <input type="hidden" name="returnDashboard" value="@returnDashboard" />

                                    <button type="submit" class="btn btn-success px-5 fw-bold shadow-sm">
                                        <i class="bi bi-check-all me-2"></i>Confirm & Finalize
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
                @* Modal for Reject Action *@
                <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle me-2"></i> Rejection Details</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>

                            <form asp-action="UpdateStatus" asp-controller="Dashboard" method="post">
                                <div class="modal-body py-4">
                                    <input type="hidden" name="applicationId" value="@Model.FinacleData.Id" />
                                    <input type="hidden" name="actionType" value="reject" />
                                    <input type="hidden" name="returnDashboard" value="@returnDashboard" />

                                    <div class="mb-4 text-center">
                                        <p class="text-muted">Set a deadline for the Relationship Manager to resolve the <strong>@Model.Discrepancies.ErrorCount mismatches</strong> found.</p>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-dark small text-uppercase">Resolution Timeline</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="bi bi-calendar-event text-danger"></i></span>
                                            <input type="datetime-local" name="deadline" class="form-control border-start-0" required
                                                   min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                        </div>
                                        <div class="form-text">RM will be notified of this deadline.</div>
                                    </div>

                               </div>

                                <div class="modal-footer bg-light border-0">
                                    <button type="button" class="btn btn-link text-muted text-decoration-none mr-auto" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger px-4 fw-bold">Send Back to RM</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>