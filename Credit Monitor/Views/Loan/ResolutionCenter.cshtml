@model Credit_Monitor.ViewModel.ValidateCATPageViewModel
@using Credit_Monitor.ViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Resolution Center";
    int i = 0;

    var savedList =
        ViewBag.ExistingResolutions as List<ResolutionItem>
        ?? new List<ResolutionItem>();

    var userRole =
        User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;

    bool isCMO =
        userRole.Equals("CMO", StringComparison.OrdinalIgnoreCase);

    bool isAOorRM =
        userRole.Equals("AO", StringComparison.OrdinalIgnoreCase) ||
        userRole.Equals("RM", StringComparison.OrdinalIgnoreCase);

    ResolutionItem? GetSaved(string fieldName)
    {
        return savedList.FirstOrDefault(r =>
            !string.IsNullOrWhiteSpace(r.Discrepancy) &&
            r.Discrepancy.Contains(
                fieldName,
                StringComparison.OrdinalIgnoreCase));
    }
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                Resolution Center
            </h4>

            <p class="text-muted mb-0">
                Reviewing @Model.Discrepancies.ErrorCount mismatches
                for Acc:
                <strong>@Model.Discrepancies.AccNum</strong>
            </p>
        </div>

        <a asp-action="ValidateCAT"
           asp-controller="Loan"
           asp-route-AccNum="@Model.FinacleData.AccountNumber"
           class="btn btn-outline-secondary btn-sm shadow-sm">

            <i class="bi bi-arrow-left me-1"></i>
            Back
        </a>
    </div>

    @if (isAOorRM && savedList.Any())
    {
        <div class="alert alert-primary border-0 shadow-sm mb-4">
            <div class="d-flex align-items-start">

                <i class="bi bi-info-circle-fill fs-4 me-3"></i>

                <div>
                    <strong>Corrective Action Required</strong>

                    <div class="small mt-1">
                        This application was returned for resolution.
                        Review the CMO instructions below, provide your
                        corrective response for every returned discrepancy,
                        then submit the application back to CMO.
                    </div>
                </div>

            </div>
        </div>
    }

   <form asp-action="@(isCMO ? "SubmitResolutions" : "SubmitResolutionResponses")"
      asp-controller="Loan"
      method="post">

    @Html.AntiForgeryToken()

        <input type="hidden"
           name="AppId"
           value="@Model.FinacleData.Id" />

        <input type="hidden"
           name="AccountNum"
           value="@Model.FinacleData.AccountNumber" />

        @* 1. Customer Name *@
        @if (!Model.Discrepancies.CustomerName.IsValid)
        {
            var existing = GetSaved("Customer Name");
            @await Html.PartialAsync("_ResolutionCard", new ResolutionItem {
            Index = i++,
                Label = "Customer Name",
                FieldName = "Customer Name",
                FinValue = Model.FinacleData.AccountName,
                CatValue = Model.CatData.CustomerName,
                Discrepancy = Model.Discrepancies.CustomerName.Message,
                Id = existing?.Id ?? Guid.Empty,
                RecommendedAction = existing?.RecommendedAction,
                Responsibility = existing?.Responsibility,
                Remarks = existing?.Remarks,
                ResolutionAction = existing?.ResolutionAction,
                ResolutionRemarks = existing?.ResolutionRemarks,
                RespondedBy = existing?.RespondedBy,
                RespondedAt = existing?.RespondedAt,
                IsCMO = isCMO
                })
                }

        @* 2. Facility Type *@
        @if (!Model.Discrepancies.FacilityType.IsValid)
        {
            var existing = GetSaved("Facility Type");
            @await Html.PartialAsync("_ResolutionCard", new ResolutionItem {
            Index = i++,
                Label = "Facility Type",
                FieldName = "Facility Type",
                FinValue = Model.FinacleData.FacilityType,
                CatValue = Model.CatData.FacilityType,
                Discrepancy = Model.Discrepancies.FacilityType.Message,
                Id = existing?.Id ?? Guid.Empty,
                RecommendedAction = existing?.RecommendedAction,
                Responsibility = existing?.Responsibility,
                Remarks = existing?.Remarks,
                ResolutionAction = existing?.ResolutionAction,
                ResolutionRemarks = existing?.ResolutionRemarks,
                RespondedBy = existing?.RespondedBy,
                RespondedAt = existing?.RespondedAt,
                IsCMO = isCMO
                })
                }

        @* 3. Approval Limit *@
        @if (!Model.Discrepancies.ApprovalLimit.IsValid)
        {
            var existing = GetSaved("Limit");
            @await Html.PartialAsync("_ResolutionCard", new ResolutionItem {
            Index = i++,
                Label = "Approval Limit",
                FieldName = "Approval Limit",
                FinValue = Model.FinacleData.SanctionLimit.ToString("N2"),
                CatValue = Model.CatData.ApprovalLimit.ToString("N2"),
                Discrepancy = Model.Discrepancies.ApprovalLimit.Message,
                Id = existing?.Id ?? Guid.Empty,
                RecommendedAction = existing?.RecommendedAction,
                Responsibility = existing?.Responsibility,
                Remarks = existing?.Remarks,
                ResolutionAction = existing?.ResolutionAction,
                ResolutionRemarks = existing?.ResolutionRemarks,
                RespondedBy = existing?.RespondedBy,
                RespondedAt = existing?.RespondedAt,
                IsCMO = isCMO
                })
                }

        @* 4. Interest Rate *@
        @if (!Model.Discrepancies.Interest.IsValid)
        {
            var existing = GetSaved("Interest");
            @await Html.PartialAsync("_ResolutionCard", new ResolutionItem {
            Index = i++,
                Label = "Interest Rate",
                FieldName = "Interest Rate",
                FinValue = Model.FinacleData.IntRateDisplay + "%",
                CatValue = Model.CatData.Interest + "%",
                Discrepancy = Model.Discrepancies.Interest.Message,
                Id = existing?.Id ?? Guid.Empty,
                RecommendedAction = existing?.RecommendedAction,
                Responsibility = existing?.Responsibility,
                Remarks = existing?.Remarks,
                ResolutionAction = existing?.ResolutionAction,
                ResolutionRemarks = existing?.ResolutionRemarks,
                RespondedBy = existing?.RespondedBy,
                RespondedAt = existing?.RespondedAt,
                IsCMO = isCMO
                })
                }

        @* 5. Maturity Date *@
        @if (!Model.Discrepancies.MaturityDate.IsValid)
        {
            var existing = GetSaved("Maturity Date");
            @await Html.PartialAsync("_ResolutionCard", new ResolutionItem {
            Index = i++,
                Label = "Maturity Date",
                FieldName = "Maturity Date",
                FinValue = Model.FinacleData.ExpiryDate.ToString("dd-MMM-yyyy"),
                CatValue = Model.CatData.MaturityOrExpiry.ToString("dd-MMM-yyyy"),
                Discrepancy = Model.Discrepancies.MaturityDate.Message,
                Id = existing?.Id ?? Guid.Empty,
                RecommendedAction = existing?.RecommendedAction,
                Responsibility = existing?.Responsibility,
                Remarks = existing?.Remarks,
                ResolutionAction = existing?.ResolutionAction,
                ResolutionRemarks = existing?.ResolutionRemarks,
                RespondedBy = existing?.RespondedBy,
                RespondedAt = existing?.RespondedAt,
                IsCMO = isCMO
                })
                }

        @* 6. Directorate *@
        @if (!Model.Discrepancies.Directorate.IsValid)
        {
            var existing = GetSaved("Directorate");
            @await Html.PartialAsync("_ResolutionCard", new ResolutionItem {
            Index = i++,
                Label = "Directorate/SBU",
                FieldName = "Directorate/SBU",
                FinValue = Model.FinacleData.SbuName,
                CatValue = Model.CatData.Directorate,
                Discrepancy = Model.Discrepancies.Directorate.Message,
                Id = existing?.Id ?? Guid.Empty,
                RecommendedAction = existing?.RecommendedAction,
                Responsibility = existing?.Responsibility,
                Remarks = existing?.Remarks,
                ResolutionAction = existing?.ResolutionAction,
                ResolutionRemarks = existing?.ResolutionRemarks,
                RespondedBy = existing?.RespondedBy,
                RespondedAt = existing?.RespondedAt,
                IsCMO = isCMO
                })
                }

        @* 7. Disbursement *@
        @if (!Model.Discrepancies.DisbursmentRequired.IsValid)
        {
            var existing = GetSaved("Disbursed Amount");
            decimal finBalance = Model.FinacleData.TotalBalanceLcy == 0 ? Model.FinacleData.TotalBalanceFcy : Model.FinacleData.TotalBalanceLcy;
            @await Html.PartialAsync("_ResolutionCard", new ResolutionItem {
            Index = i++,
                Label = "Disbursed Amount",
                FieldName = "Disbursed Amount",
                FinValue = finBalance.ToString("N2"),
                CatValue = Model.CatData.DisbursementRequired.ToString("N2"),
                Discrepancy = Model.Discrepancies.DisbursmentRequired.Message,
                Id = existing?.Id ?? Guid.Empty,
                RecommendedAction = existing?.RecommendedAction,
                Responsibility = existing?.Responsibility,
                Remarks = existing?.Remarks,
                ResolutionAction = existing?.ResolutionAction,
                ResolutionRemarks = existing?.ResolutionRemarks,
                RespondedBy = existing?.RespondedBy,
                RespondedAt = existing?.RespondedAt,
                IsCMO = isCMO
                })
                }

        @* 8. Fees *@
        @if (!Model.Discrepancies.Fee.IsValid)
        {
            var existing = GetSaved("Fee");
            @await Html.PartialAsync("_ResolutionCard", new ResolutionItem {
            Index = i++,
                Label = "Fees",
                FieldName = "Fees",
                FinValue = Model.FinacleData.FxRate.ToString("N2"),
                CatValue = Model.CatData.Fees.ToString("N2"),
                Discrepancy = Model.Discrepancies.Fee.Message,
                Id = existing?.Id ?? Guid.Empty,
                RecommendedAction = existing?.RecommendedAction,
                Responsibility = existing?.Responsibility,
                Remarks = existing?.Remarks,
                ResolutionAction = existing?.ResolutionAction,
                ResolutionRemarks = existing?.ResolutionRemarks,
                RespondedBy = existing?.RespondedBy,
                RespondedAt = existing?.RespondedAt,
                IsCMO = isCMO
                })
                }

        @* 9. Value Date *@
        @if (!Model.Discrepancies.ValueDate.IsValid)
        {
            var existing = GetSaved("Value Date");
            @await Html.PartialAsync("_ResolutionCard", new ResolutionItem {
            Index = i++,
                Label = "Value Date",
                FieldName = "Value Date",
                FinValue = Model.FinacleData.DateGranted.ToString("dd-MMM-yyyy"),
                CatValue = Model.CatData.ValueDate.ToString("dd-MMM-yyyy"),
                Discrepancy = Model.Discrepancies.ValueDate.Message,
                Id = existing?.Id ?? Guid.Empty,
                RecommendedAction = existing?.RecommendedAction,
                Responsibility = existing?.Responsibility,
                Remarks = existing?.Remarks,
                ResolutionAction = existing?.ResolutionAction,
                ResolutionRemarks = existing?.ResolutionRemarks,
                RespondedBy = existing?.RespondedBy,
                RespondedAt = existing?.RespondedAt,
                IsCMO = isCMO
                })
                }

        @* Summary Footer *@
        <div class="card bg-light border-0 shadow-sm mb-5 rounded-3">
    <div class="card-body d-flex justify-content-between
                align-items-center py-4">

        <div>

            @if (isCMO)
            {
                <span class="text-muted fw-bold d-block">
                    Batch Submission
                </span>

                <span class="small text-muted">
                    You are resolving
                    <strong>@i</strong>
                    items simultaneously.
                </span>
            }
            else
            {
                <span class="text-muted fw-bold d-block">
                    Resolution Response
                </span>

                <span class="small text-muted">
                    Complete all
                    <strong>@i</strong>
                    returned discrepancies before submitting to CMO.
                </span>
            }

        </div>

        @if (isCMO)
        {
            <button type="submit"
                    class="btn btn-success btn-lg px-5
                           fw-bold shadow-sm">

                <i class="bi bi-cloud-upload me-2"></i>
                Submit All Resolutions
            </button>
        }
        else
        {
            <button type="submit"
                    class="btn btn-primary btn-lg px-5
                           fw-bold shadow-sm">

                <i class="bi bi-send me-2"></i>
                Submit All Responses to CMO
            </button>
        }

    </div>
</div>
</form>